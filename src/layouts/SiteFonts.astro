---
/**
 * Emit Astro Font faces only when the runtime font map has data.
 * Google CJK families can briefly be missing after a cold `astro dev` start
 * or during HMR; throwing FontFamilyNotFound would blank the whole page.
 */
import { Font } from "astro:assets";
import { componentDataByCssVariable } from "virtual:astro:assets/fonts/internal";
import { siteFonts } from "../../site-fonts.mjs";

const readyFonts = siteFonts.filter((entry) =>
  componentDataByCssVariable.has(entry.cssVariable)
);

if (readyFonts.length !== siteFonts.length && import.meta.env.DEV) {
  const missing = siteFonts
    .filter((entry) => !componentDataByCssVariable.has(entry.cssVariable))
    .map((entry) => entry.cssVariable);
  console.warn(`[SiteFonts] Skipping unavailable font families: ${missing.join(", ")}`);
}
---

{readyFonts.map((entry) => <Font cssVariable={entry.cssVariable} />)}
