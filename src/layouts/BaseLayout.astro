---
import { ClientRouter } from "astro:transitions";
import SeoHead from "@components/utils/SeoHead.astro";
import StructuredData from "@components/utils/StructuredData.astro";
import type { Locale } from "@i18n/config";
import { defaultLocale, localeHtmlLang } from "@i18n/config";
import { getSeo } from "@i18n/loadData";
import siteConfig from "@data/site.json";
import "@styles/style.css";
import SiteFonts from "@layouts/SiteFonts.astro";
import VideoElements from "@components/utils/VideoElements.astro";
import type { SeoMetadata } from "../types";

export interface Props extends SeoMetadata {
  locale?: Locale;
}

const props = Astro.props;
const locale = props.locale ?? defaultLocale;
const seoData = getSeo(locale);
const htmlLang = localeHtmlLang[locale];
const faviconSrc = siteConfig.faviconSrc || "/favicon.png";
const faviconVersion = "2";
const faviconHref = `${faviconSrc}?v=${faviconVersion}`;
---

<!doctype html>
<html
  lang={htmlLang}
  data-theme="light"
>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <link
      rel="icon"
      href="/favicon.ico?v=2"
      sizes="any"
    />
    <link
      rel="icon"
      type="image/png"
      href={faviconHref}
    />
    <link
      rel="apple-touch-icon"
      href={`/apple-touch-icon.png?v=${faviconVersion}`}
    />
    <meta
      name="generator"
      content={Astro.generator}
    />
    <style is:inline>
      @layer reset, base, components, page-sections, utils, overrides;
    </style>

    <SiteFonts />

    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    {
      import.meta.env.DEV ? (
        <script
          type="module"
          src="/@vite/client"
        />
      ) : null
    }

    <link
      rel="preload"
      href="/fonts/JetBrains Mono/jetbrains-mono-v24-latin-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script>
      if (window.inEditorMode) {
        import("../../live-editing");
        import("../../editor-live-sync");
      }
    </script>

    <SeoHead
      site={seoData}
      title={props.title}
      description={props.description}
      keywords={props.keywords}
      image={props.image}
      canonical={props.canonical}
      type={props.type}
      article={props.article}
      noindex={props.noindex}
    />

    <StructuredData site={seoData} />

    <link
      rel="sitemap"
      type="application/xml"
      title="Sitemap"
      href="/sitemap-index.xml"
    />

    <!-- Page Layout 可透過這個 slot 加入該頁專屬的 head 內容。 -->
    <slot name="head" />
    <script is:inline>
      // 不讓瀏覽器自動回到舊捲動位置，避免切換頁面時上下跳動。
      if ("scrollRestoration" in history) {
        history.scrollRestoration = "manual";
      }

      if (!window.__ccelectScrollHistoryDisabled) {
        window.__ccelectScrollHistoryDisabled = true;
        window.addEventListener(
          "popstate",
          () => {
            if (history.state && !window.location.hash) {
              history.replaceState({ ...history.state, scrollX: 0, scrollY: 0 }, "");
            }
          },
          { capture: true }
        );
      }
    </script>
    <!-- ClientRouter 讓 Astro 換頁時保留動畫與共用導覽列。 -->
    <ClientRouter />
  </head>
  <body>
    <slot />
    <VideoElements />
  </body>
</html>
