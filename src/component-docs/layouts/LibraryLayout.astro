---
import "@component-docs/styles/component-docs.css";
import VideoElements from "@components/utils/VideoElements.astro";
import SiteFonts from "@layouts/SiteFonts.astro";
import "@styles/style.css";
import { ClientRouter, fade } from "astro:transitions";
import { z } from "zod/v4";

const libraryLayoutSchema = z.object({
  frontmatter: z
    .object({
      title: z.string().optional(),
      description: z.string().optional(),
      contentSections: z.array(z.any()).optional(),
    })
    .optional(),
});

import CustomSection from "@builders/custom-section/CustomSection.astro";
import MobileNavLayout from "@component-docs/layouts/MobileNavLayout.astro";
import SidebarNavLayout from "@component-docs/layouts/SidebarNavLayout.astro";
import ThemeToggleScript from "@components/navigation/theme-toggle/ThemeToggleScript.astro";
import RenderBlock from "@components/utils/renderBlock.astro";
import siteConfig from "@data/site.json";
const props = libraryLayoutSchema.parse(Astro.props);
const pageTitle = props.frontmatter?.title || "Component Library";
const pageDescription = props.frontmatter?.description;
const contentSections = props.frontmatter?.contentSections || [];
const faviconSrc = siteConfig.faviconSrc || "/favicon.png";
const faviconVersion = "2";
const faviconHref = `${faviconSrc}?v=${faviconVersion}`;
---

<!doctype html>
<html
  lang="en"
  data-theme="light"
>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <link
      rel="icon"
      href="/favicon.ico?v=2"
      sizes="any"
    />
    <link
      rel="icon"
      type="image/png"
      href={faviconHref}
    />
    <link
      rel="apple-touch-icon"
      href={`/apple-touch-icon.png?v=${faviconVersion}`}
    />
    <meta
      name="generator"
      content={Astro.generator}
    />
    <ThemeToggleScript />
    <style is:inline>
      @layer reset, base, components, page-sections, utils, overrides;
    </style>
    <SiteFonts />
    {
      import.meta.env.DEV ? (
        <script
          type="module"
          src="/@vite/client"
        />
      ) : null
    }
    <title>{pageTitle}</title>
    <meta
      name="robots"
      content="noindex"
    />
    {
      pageDescription ? (
        <meta
          name="description"
          content={pageDescription}
        />
      ) : null
    }
    <slot name="head" />
    <ClientRouter />
  </head>
  <body
    class="component-docs"
    data-pagefind-ignore
  >
    <div transition:animate={fade({ duration: "0.2s" })}>
      <MobileNavLayout />
      <CustomSection
        maxContentWidth="2xl"
        paddingHorizontal="md"
        paddingVertical="none"
        class="library-container"
      >
        <SidebarNavLayout />
        <main class="main">
          <div
            data-editable="array"
            data-children-prop="contentSections"
          >
            <RenderBlock contentSections={contentSections} />
          </div>
          <slot />
        </main>
      </CustomSection>
      <VideoElements />
    </div>
  </body>
</html>
