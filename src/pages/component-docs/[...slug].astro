---
import LibraryLayout from "@component-docs/layouts/LibraryLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  if (process.env.DISABLE_COMPONENT_DOCS === "true") return [];

  const pages = await getCollection("docs-pages");

  return pages
    .filter((page) => page.id !== "component-builder")
    .map((page) => ({
      params: { slug: page.id === "index" ? undefined : page.id },
      props: { page },
    }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<LibraryLayout frontmatter={page.data}>
  <Content />
</LibraryLayout>
