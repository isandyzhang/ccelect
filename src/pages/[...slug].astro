---
import Page from "@layouts/Page.astro";
import {
  defaultLocale,
  pageKeyFromContentId,
  pageSlugParam,
  parseLocaleId,
  type Locale,
} from "@i18n/config";
import { getCollection, render, type CollectionEntry } from "astro:content";

export interface Props {
  page: CollectionEntry<"pages">;
  locale: Locale;
  pageKey: string;
}

export async function getStaticPaths() {
  // 建置時把 content/pages 裡的內容轉成實際網址。
  const pages = await getCollection("pages");

  return pages
    .filter((page) => {
      const { rest } = parseLocaleId(page.id);

      if (rest === "blog" || rest.endsWith("/blog")) return false;
      if (rest === "404" || rest.endsWith("/404")) return false;
      return true;
    })
    .map((page) => {
      const { locale, rest } = parseLocaleId(page.id);
      const pageKey = pageKeyFromContentId(rest);
      const slug = pageSlugParam(locale, rest);

      return {
        params: { slug },
        props: { page, locale, pageKey },
      };
    });
}

const { page, locale = defaultLocale, pageKey = "" } = Astro.props;
const { Content } = await render(page);
---

<Page
  frontmatter={page.data}
  locale={locale}
  pageKey={pageKey}
>
  <Content />
</Page>
