---
import { pascalToKebab } from "@components/utils/pascalToKebab";
import type { ContentBlock } from "../../types";

export interface Props {
  contentSections: ContentBlock[];
  useDefaultEditableBinding?: boolean;
}

type AstroComponent = (_props: Record<string, unknown>) => unknown;
type AstroComponentModule = { default: AstroComponent };

// Astro 在建置時找出所有區塊元件，讓內容只要用 _component 指定元件。
const componentImports = import.meta.glob<AstroComponentModule>("../**/*.{jsx,astro}", {
  eager: true,
});
const componentRegistry: Record<string, AstroComponent> = {};

Object.entries(componentImports).forEach(([path, componentModule]) => {
  const parts = path.replace("../", "").split(".")[0].split("/");
  const filename = parts[parts.length - 1];
  const kebabFilename = pascalToKebab(filename);

  // 資料夾和檔名相同時只保留一層，例如 button/Button.astro → button。
  if (parts.length > 1 && kebabFilename === parts[parts.length - 2]) {
    parts.pop();
    parts[parts.length - 1] = kebabFilename;
  } else {
    parts[parts.length - 1] = kebabFilename;
  }

  componentRegistry[parts.join("/")] = componentModule.default;
});

const { contentSections, useDefaultEditableBinding = true } = Astro.props;
---

{
  // Array-level editable attributes are owned by the caller's container element.
  // This utility only resolves blocks and marks each rendered block as an array item.
  contentSections?.map((block) => {
    const Component = componentRegistry[block._component];

    if (!Component && block._component) {
      console.warn(
        `Component not found: ${block._component}. Available components:`,
        Object.keys(componentRegistry)
      );
    }

    return Component ? (
      <Component
        data-editable={useDefaultEditableBinding ? "array-item" : undefined}
        data-id={block._component}
        {...block}
        useDefaultEditableBinding={useDefaultEditableBinding}
      />
    ) : null;
  })
}
