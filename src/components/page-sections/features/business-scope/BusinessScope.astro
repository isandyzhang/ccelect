                  />
                </svg>
              )}
              {item.id === "process" && (
                <svg
                  viewBox="0 0 280 200"
                  aria-hidden="true"
                  focusable="false"
                >
                  <g class="sheet" style="--sheet-x: -14px; --sheet-y: 8px">
                    <path class="draw" pathLength="1" d="M 66.8 99.9 L 144.5 144.7 L 105.7 167.1 L 28 122.3 Z M 144.5 151.6 L 105.7 174 L 105.7 167.1 L 144.5 144.7 Z M 28 129.2 L 105.7 174 L 105.7 167.1 L 28 122.3 Z" />
                  </g>
                  <g class="sheet" style="--sheet-x: -7px; --sheet-y: 4px">
