          </Tag>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";

  let observers: IntersectionObserver[] = [];

  function initBusinessScope() {
    observers.forEach((observer) => observer.disconnect());
    observers = [];

    document.querySelectorAll<HTMLElement>("[data-business-scope]").forEach((section) => {
      if (section.classList.contains("is-inview")) return;

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-inview");
            observer.disconnect();
          });
        },
        { threshold: 0.28, rootMargin: "0px 0px -8% 0px" }
      );

      observer.observe(section);
      observers.push(observer);
    });
  }

  onPageLoad(initBusinessScope);
</script>

<style>
  .business-scope {
    --scope-line: var(--color-border);
    --scope-stroke: color-mix(in srgb, var(--color-text-strong) 82%, transparent);
    --scope-pulse: var(--palette-brand);
    --scope-accent: var(--pink-8);
    --scope-accent-glow: color-mix(in srgb, var(--pink-8) 55%, transparent);
    background: var(--color-bg);
    color: var(--color-text);
    padding-block: var(--spacing-4xl);
    padding-inline: var(--spacing-lg);
  }

  :global([data-theme="dark"]) .business-scope {
    --scope-pulse: color-mix(in srgb, white 78%, var(--palette-brand-bright));
    --scope-accent: var(--palette-accent);
    --scope-accent-glow: color-mix(in srgb, var(--palette-accent) 70%, transparent);
    background: var(--purple-12);
  }

  .business-scope-inner {
    margin-inline: auto;
    width: min(100%, var(--content-width-3xl));
  }

  .scope-header {
    margin-inline: auto;
    max-width: 40rem;
    text-align: center;
  }

  .scope-eyebrow {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.14em;
    margin: 0 0 var(--spacing-sm);
    text-transform: uppercase;
  }

  .scope-heading {
    color: var(--color-text-strong);
    font-size: var(--font-size-heading-lg);
    font-weight: var(--font-weight-medium);
    line-height: 1.3;
    margin: 0;
  }

  .scope-subtext {
    color: var(--color-text-muted);
    font-size: var(--font-size-md);
    line-height: 1.6;
    margin: var(--spacing-sm) 0 0;
  }

  .scope-grid {
    display: grid;
    grid-template-columns: 1fr;
    margin-top: var(--spacing-3xl);
  }

  .scope-figure {
    color: inherit;
    min-width: 0;
    padding: var(--spacing-xl) var(--spacing-lg) var(--spacing-md);
    text-decoration: none;
  }

  a.scope-figure:hover .scope-title,
  a.scope-figure:focus-visible .scope-title {
    color: var(--color-text-strong);
  }

  a.scope-figure:focus-visible {
    outline: 2px solid var(--palette-brand-bright);
    outline-offset: -2px;
  }

  .scope-figure + .scope-figure {
    border-top: 1px solid var(--scope-line);
  }

  .scope-fig {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    letter-spacing: 0.16em;
    margin: 0 0 var(--spacing-md);
    text-transform: uppercase;
  }

  .scope-art {
    display: grid;
    margin-bottom: var(--spacing-xl);
    min-height: 13rem;
    place-items: center;
  }

  .scope-art svg {
    height: auto;
    overflow: visible;
    width: min(100%, 280px);
  }

  .draw,
  .pulse {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .draw {
    stroke: var(--scope-stroke);
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    stroke-width: 1.35;
    transition: stroke-dashoffset 1.1s ease;
    transition-delay: var(--draw-delay, 0s);
  }

  .is-inview .draw {
    stroke-dashoffset: 0;
  }

  .pulse {
    opacity: 0;
    stroke: var(--scope-pulse);
    stroke-dasharray: 0.18 0.82;
    stroke-width: 2.1;
  }

  .pulse-accent {
    filter: drop-shadow(0 0 4px var(--scope-accent-glow));
    stroke: var(--scope-accent);
  }

  .is-inview .pulse {
    animation: scope-travel 7s linear var(--idle-delay, 1.5s) infinite;
  }

  .is-inview .lid {
    animation: scope-lid 7s ease-in-out var(--idle-delay, 1.5s) infinite;
  }

  .is-hover-motion .draw {
    stroke-dashoffset: 0;
    transition: none;
  }

  .is-hover-motion.is-inview .pulse,
  .is-hover-motion.is-inview .lid {
    animation: none;
  }

  .sheet {
    transition: transform 0.55s ease;
  }

  .is-hover-motion .scope-art svg {
    transition: transform 0.45s ease;
  }

  @media (hover: hover) {
    .is-hover-motion .scope-figure:hover .draw,
    .is-hover-motion .scope-figure:focus-within .draw {
      animation: scope-redraw 1.05s ease;
    }

    .is-hover-motion .scope-figure:hover .pulse,
    .is-hover-motion .scope-figure:focus-within .pulse {
      animation: scope-travel 2.4s linear infinite;
    }

    .is-hover-motion .scope-figure:hover .lid,
    .is-hover-motion .scope-figure:focus-within .lid {
      animation: scope-lid 2.6s ease-in-out infinite;
    }

    .is-hover-motion .scope-figure:hover .scope-art svg,
    .is-hover-motion .scope-figure:focus-within .scope-art svg {
      transform: translateY(-6px);
    }

    .is-hover-motion .scope-figure:hover .sheet,
    .is-hover-motion .scope-figure:focus-within .sheet {
      transform: translate(var(--sheet-x), var(--sheet-y));
    }
  }

  .scope-title {
    color: var(--color-text-strong);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    line-height: 1.4;
    margin: 0 0 var(--spacing-xs);
  }

  .scope-desc {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    line-height: 1.65;
    margin: 0;
  }

  @media (width >= 720px) {
    .scope-grid {
      grid-template-columns: 1fr 1fr;
    }

    .scope-figure + .scope-figure {
      border-top: 0;
    }

    .scope-figure:nth-child(odd) {
      border-inline-end: 1px solid var(--scope-line);
    }

    .scope-figure:nth-child(n + 3) {
      border-top: 1px solid var(--scope-line);
    }
  }

  @media (width >= 720px) {
    .scope-grid[data-count="3"] {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .scope-grid[data-count="3"] .scope-figure:nth-child(odd) {
      border-inline-end: 0;
    }

    .scope-grid[data-count="3"] .scope-figure:nth-child(n + 3) {
      border-top: 0;
    }

    .scope-grid[data-count="3"] .scope-figure + .scope-figure {
      border-inline-start: 1px solid var(--scope-line);
      border-top: 0;
    }
  }

  @media (width >= 1100px) {
    .scope-grid {
      grid-template-columns: repeat(var(--scope-columns, 4), minmax(0, 1fr));
    }

    .scope-figure:nth-child(odd) {
      border-inline-end: 0;
    }

    .scope-figure:nth-child(n + 3) {
      border-top: 0;
    }

    .scope-figure + .scope-figure {
      border-inline-start: 1px solid var(--scope-line);
    }
  }

  @keyframes scope-redraw {
    from {
      stroke-dashoffset: 1;
    }

    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes scope-lid {
    0%,
    22%,
    100% {
      transform: translateY(0);
    }

    48%,
    70% {
      transform: translateY(-8px);
    }
  }

  @keyframes scope-travel {
    0% {
      opacity: 1;
      stroke-dashoffset: 0;
    }

    88% {
      opacity: 1;
    }

    100% {
      opacity: 0.35;
      stroke-dashoffset: -1;
    }
  }
</style>
