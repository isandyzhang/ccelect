---
interface ScopeItem {
  id?: string;
  figure?: string | number;
  title?: string;
  description?: string;
  link?: string;
}

interface Props {
  id?: string;
  eyebrowText?: string;
  heading?: string;
  subtext?: string;
  items?: ScopeItem[];
  motion?: "scroll" | "hover";
}

const {
  id,
  eyebrowText = "",
  heading = "",
  subtext = "",
  items = [],
  motion = "scroll",
} = Astro.props as Props;

const headingId = id ? `${id}-heading` : "business-scope-heading";

function figureLabel(figure: string | number | undefined, index: number) {
  const raw = String(figure ?? index + 1);

  return raw.padStart(2, "0");
}
---

<section
  class:list={["business-scope", motion === "hover" && "is-hover-motion"]}
  data-business-scope
  id={id}
  aria-labelledby={heading ? headingId : undefined}
>
  <div class="business-scope-inner">
    <header class="scope-header">
      {eyebrowText && <p class="scope-eyebrow">{eyebrowText}</p>}
      {heading && (
        <h2
          id={headingId}
          class="scope-heading"
        >
          {heading}
        </h2>
      )}
      {subtext && <p class="scope-subtext">{subtext}</p>}
    </header>

    <div
      class="scope-grid"
      data-count={items.length}
      style={`--scope-columns: ${items.length || 1}`}
    >
      {
        items.map((item, index) => {
          const Tag = item.link ? "a" : "article";

          return (
          <Tag
            class="scope-figure"
            href={item.link || undefined}
            style={`--draw-delay: ${index * 0.15}s; --idle-delay: ${1.45 + index * 0.12}s`}
