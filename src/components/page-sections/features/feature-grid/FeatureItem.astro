---
import Heading from "@core-elements/heading/Heading.astro";
import Icon from "@core-elements/icon/Icon.astro";
import Image from "@core-elements/image/Image.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";
import BentoBoxGridItem from "@wrappers/bento-box-grid/BentoBoxGridItem.astro";
import Card from "@wrappers/card/Card.astro";

const {
  link = "",
  image = {
    source: "",
    alt: "",
  },
  eyebrowIcon = {},
  eyebrowText = "",
  title = "",
  description = "",
  columnSpan,
  rowSpan,
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const hasTitle = Boolean(title?.trim());
const hasDescription = Boolean(description?.trim());
const hasEyebrow = Boolean(eyebrowText?.trim());
const hasEyebrowIcon = Boolean(eyebrowIcon?.name);
const hasCopy = hasTitle || hasDescription || hasEyebrow || hasEyebrowIcon;
const isShowcase = Boolean(image?.source) && !hasCopy;
---

<BentoBoxGridItem
  columnSpan={columnSpan}
  rowSpan={rowSpan}
  class:list={["feature-grid-item", isShowcase && "feature-grid-item-showcase"]}
  {...htmlAttributes}
>
  <Card
    class:list={["feature-item", isShowcase && "feature-item-showcase", className]}
    paddingHorizontal={isShowcase ? "" : "lg"}
    paddingVertical={isShowcase ? "" : "lg"}
    rounded
    border={!isShowcase}
    backgroundColor={isShowcase ? "" : "base"}
    link={link}
  >
    <Fragment slot="before">
      {isShowcase && image.alt && <span class="visually-hidden">{image.alt}</span>}
      <Image
        {...image}
        data-prop-src="image.source"
        data-prop-alt="image.alt"
      />
    </Fragment>
    {
      !isShowcase && (
        <>
          <Icon
            {...eyebrowIcon}
            data-prop="eyebrowIcon"
          />
          <SimpleText
            class="eyebrow"
            data-prop="eyebrowText"
            text={eyebrowText}
          />
          {hasTitle && (
            <Heading
              class="feature-title"
              level="h3"
              size="md"
              alignmentHorizontal="start"
              data-prop="title"
            >
              {title}
            </Heading>
          )}
          {hasDescription && (
            <Text
              class="feature-description"
              alignmentHorizontal="start"
              data-prop="description"
              text={description}
            />
          )}
        </>
      )
    }
  </Card>
</BentoBoxGridItem>

<style is:global>
  @layer page-sections {
    .feature-item {
      display: flex;
      flex-direction: column;
      height: 100%;

      .card-content {
        color: var(--color-text);
        display: flex;
        flex-direction: column;
        flex: 1;
        justify-content: flex-start;
      }
    }

    .feature-title,
    .feature-item .heading,
    .feature-item .heading-text {
      color: var(--color-text-strong);
      margin-bottom: var(--spacing-sm);
      margin-top: var(--spacing-sm);
    }

    .feature-description {
      color: var(--color-text);
      margin-top: 0;
    }

    .feature-item-showcase {
      .card-outer-content {
        display: none;
      }

      .before-content,
      .image {
        width: 100%;
      }

      img {
        display: block;
        height: auto;
        object-fit: contain;
        width: 100%;
      }
    }
  }
</style>
