---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Icon from "@core-elements/icon/Icon.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";
import BentoBoxGrid from "@wrappers/bento-box-grid/BentoBoxGrid.astro";
import RenderBlock from "@components/utils/renderBlock.astro";

const {
  id = "",
  eyebrowIcon = {},
  eyebrowText = "",
  heading = "",
  subtext = "",
  featureGrid = {
    features: [],
    backgroundColor: "base",
    gridMaxWidth: "2xl",
    gridBackgroundMaxWidth: "none",
    rounded: false,
    overhang: false,
  },
  maxContentWidth = "xl",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  backgroundColor,
  contentBackground,
  verticalOffset = {},
  rounded = false,
  class: className,
  _component,
  ...htmlAttributes
} = Astro.props;
---

<CustomSection
  class:list={["feature-grid", className]}
  maxContentWidth=""
  paddingHorizontal=""
  paddingVertical={paddingVertical}
  rounded={rounded}
  colorScheme={colorScheme}
  backgroundColor={backgroundColor}
  verticalOffset={verticalOffset}
  id={id}
  {...htmlAttributes}
>
  <CustomSection
    class:list={["feature-grid-content", className]}
    style={`--padding-between: var(--spacing-${paddingVertical})`}
    maxContentWidth={maxContentWidth}
    paddingHorizontal="md"
    paddingVertical=""
    rounded={rounded}
    colorScheme={colorScheme}
    backgroundColor=""
    contentBackground={contentBackground}
  >
    <Icon {...eyebrowIcon} />
    <SimpleText
      alignmentHorizontal="center"
      class="eyebrow"
      data-prop="eyebrowText"
    >
      {eyebrowText}
    </SimpleText>
    <Heading
      level="h2"
      size="lg"
      alignmentHorizontal="center"
      data-prop="heading"
      text={heading}
    />
    <Text
      class="feature-grid-subtext"
      alignmentHorizontal="center"
      data-prop="subtext"
      text={subtext}
    />
  </CustomSection>

  <CustomSection
    class:list={["feature-grid-background"]}
    maxContentWidth={featureGrid.gridBackgroundMaxWidth}
    paddingHorizontal=""
    paddingVertical="xs"
    colorScheme={colorScheme}
  >
    <CustomSection
      class:list={["feature-grid-grid", featureGrid.overhang && "feature-grid-background-overhang"]}
      maxContentWidth={featureGrid.gridMaxWidth}
      colorScheme={colorScheme}
      paddingVertical=""
      paddingHorizontal="md"
      backgroundColor={featureGrid.backgroundColor}
      rounded={featureGrid.rounded}
    >
      <BentoBoxGrid
        gap="md"
        data-children-prop="featureGrid.features"
        class="feature-grid-grid"
      >
        {
          featureGrid.features && (
            <RenderBlock
              contentSections={featureGrid.features}
              useDefaultEditableBinding={true}
            />
          )
        }
      </BentoBoxGrid>
    </CustomSection>
  </CustomSection>
</CustomSection>

<script>
  import "@components/page-sections/products/product-showcase/product-showcase";
  import { onPageLoad } from "@component-utils/onPageLoad";

  function initShowcaseReveal() {
    const sections = document.querySelectorAll<HTMLElement>(
      ".feature-grid:has(.feature-item-showcase)"
    );

    if (!sections.length) return;

    const clamp = (value: number) => Math.min(1, Math.max(0, value));

    const measure = () => {
      sections.forEach((section) => {
        const outer = section.querySelector<HTMLElement>(":scope > .outer-content");
        const photo = section.querySelector<HTMLElement>("product-showcase");
        const natural = photo?.offsetHeight ?? outer?.offsetHeight ?? 0;
        const frame = Math.min(natural || window.innerHeight, window.innerHeight);
        section.toggleAttribute("data-showcase-stick", frame > 0);
        if (outer) outer.style.top = frame > 0 ? "0px" : "";
        section.style.minHeight = frame > 0 ? `${frame + window.innerHeight * 2.4}px` : "";

        const rect = section.getBoundingClientRect();
        const progress = clamp(-rect.top / Math.max(1, rect.height - window.innerHeight));

        section.style.setProperty("--showcase-p", progress.toFixed(4));
      });
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        measure();
      });
    };

    measure();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
  }

  function initMosaicMotion() {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const canHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
    const sections = document.querySelectorAll<HTMLElement>(".feature-grid-mosaic");

    if (!sections.length || reduce) return;

    sections.forEach((section) => {
      if (section.dataset.mosaicReady === "true") return;
      section.dataset.mosaicReady = "true";

      const videos = Array.from(section.querySelectorAll<HTMLVideoElement>("video.feature-hover-video"));
      const reveal = () => {
        section.classList.add("is-mosaic-in");
        if (!canHover) return;
        videos.forEach((video) => {
          const src = video.dataset.src;
          if (!src || video.getAttribute("src")) return;
          video.src = src;
          video.load();
        });
      };
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          reveal();
          observer.disconnect();
        },
        { rootMargin: "0px 0px -8% 0px", threshold: 0.15 }
      );

      observer.observe(section);

      if (!canHover) return;

      videos.forEach((video) => {
        const card = video.closest<HTMLElement>(".feature-item");
        if (!card) return;

        card.addEventListener("pointerenter", () => {
          const src = video.dataset.src;
          if (src && !video.getAttribute("src")) {
            video.src = src;
            video.load();
          }
          card.classList.add("is-playing");
          void video.play().catch(() => {});
        });
        card.addEventListener("pointerleave", () => {
          card.classList.remove("is-playing");
          video.pause();
          if (Number.isFinite(video.duration)) video.currentTime = 0;
        });
      });
    });
  }

  onPageLoad(() => {
    initShowcaseReveal();
    initMosaicMotion();
  });
</script>
<script is:inline>
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.documentElement.classList.add("mosaic-motion");
  }
</script>

<style is:global>
  @layer page-sections {
    .feature-grid-content {
      padding-bottom: var(--padding-between);
    }

    .feature-grid-background-overhang > .outer-content > .background {
      margin-top: var(--spacing-3xl);
      margin-bottom: var(--spacing-3xl);
    }

    .feature-grid-background-overhang > .outer-content.rounded > .background {
      border-radius: var(--radius-3xl);
    }

    .feature-grid:has(.feature-item-showcase) {
      --showcase-p: 0;

      > .outer-content > .content {
        display: grid;
        padding-block: 0;

        > .feature-grid-content,
        > .feature-grid-background {
          grid-area: 1 / 1;
          min-width: 0;
          width: 100%;
        }
      }

      .feature-grid-background {
        z-index: 0;

        > .outer-content > .content {
          padding-block: 0;
        }
      }

      .bento-box-grid.feature-grid-grid {
        margin-top: 0;
      }

      .feature-grid-grid > .outer-content > .content {
        padding-inline: 0;
      }

      .feature-grid-item-showcase {
        padding: 0;
      }

      .feature-item-showcase.card,
      .feature-item-showcase .image {
        margin-top: 0;
      }

      .feature-item-showcase.card:has(> a.card-inner)::before {
        content: none;
      }

      .feature-item-showcase > .card-inner {
        border-radius: 0;

        > .before-content {
          z-index: 0;
        }
      }

      &[data-showcase-stick] {
        background: #050505;
      }

      &[data-showcase-stick] > .outer-content {
        background: #050505;
        height: auto;
        min-height: 100dvh;
        position: sticky;
        top: 0;
      }

      &[data-showcase-stick] product-showcase .showcase-media {
        aspect-ratio: auto;
        height: min(75vw, 100dvh);
      }

      product-showcase.feature-item-showcase::after,
      .feature-item-showcase > .card-inner::after {
        background-color: #000;
        content: "";
        inset: 0;
        opacity: calc(0.92 - 0.64 * clamp(0, (var(--showcase-p) - 0.06) / 0.7, 1));
        pointer-events: none;
        position: absolute;
        z-index: 1;
      }

      .feature-grid-content {
        opacity: 1;
        padding-block: 0;
        pointer-events: none;
        position: relative;
        z-index: 3;

        > .eyebrow,
        > .outer-content > .content > .eyebrow,
        > .heading,
        > .outer-content > .content > .heading,
        > .feature-grid-subtext,
        > .outer-content > .content > .feature-grid-subtext {
          opacity: var(--line, 0);
          transform: translate3d(0, calc((1 - var(--line, 0)) * 1.25rem), 0);
        }

        > .eyebrow,
        > .outer-content > .content > .eyebrow {
          --line: clamp(0, (var(--showcase-p) - 0.48) / 0.22, 1);
        }

        > .heading,
        > .outer-content > .content > .heading {
          --line: clamp(0, (var(--showcase-p) - 0.62) / 0.22, 1);
        }

        > .feature-grid-subtext,
        > .outer-content > .content > .feature-grid-subtext {
          --line: clamp(0, (var(--showcase-p) - 0.76) / 0.2, 1);
        }

        > .outer-content,
        > .outer-content > .content {
          height: 100%;
          min-width: 0;
          width: 100%;
        }

        > .outer-content > .content {
          align-content: end;
          box-sizing: border-box;
          column-gap: clamp(1.75rem, 5vw, 4.5rem);
          display: grid;
          grid-template-columns: minmax(min-content, 0.72fr) minmax(0, 1.4fr);
          padding: clamp(1.5rem, 4vw, 3.25rem);
          row-gap: 0.7rem;
        }

        > .outer-content > .content > .eyebrow {
          grid-column: 1;
          grid-row: 1;
        }

        > .outer-content > .content > .heading {
          grid-column: 1;
          grid-row: 2;
        }

        > .outer-content > .content > .feature-grid-subtext {
          align-self: end;
          grid-column: 2;
          grid-row: 2;
        }

        .eyebrow,
        .heading,
        .feature-grid-subtext {
          margin: 0;
        }

        .heading-text {
          white-space: nowrap;
        }

        .heading-inner {
          font-size: clamp(2.35rem, 4.4vw, 4.5rem);
          font-weight: var(--font-weight-semibold);
          letter-spacing: -0.035em;
          line-height: 0.98;
        }

        .eyebrow,
        .eyebrow .simple-text-inner,
        .eyebrow .simple-text-content,
        .heading,
        .heading-inner,
        .heading-text,
        .feature-grid-subtext,
        .feature-grid-subtext .text-inner,
        .feature-grid-subtext p {
          color: #fff;
          text-align: start;
          text-shadow: 0 1px 12px rgba(0, 0, 0, 0.35);
        }

        .eyebrow,
        .eyebrow .simple-text-content {
          color: rgba(255, 255, 255, 0.72);
          font-size: 0.82rem;
          letter-spacing: 0.08em;
        }

        .feature-grid-subtext {
          margin-inline: 0;
          max-width: none;
          width: max-content;
        }

        .feature-grid-subtext,
        .feature-grid-subtext p {
          font-size: clamp(0.95rem, 1.15vw, 1.125rem);
          line-height: 1.55;
        }

        .feature-grid-subtext p {
          white-space: nowrap;
        }

        @media (width < 72rem) {
          .feature-grid-subtext {
            max-width: 100%;
            min-width: 0;
            width: auto;
          }

          .feature-grid-subtext p {
            white-space: normal;
          }

          > .outer-content > .content > .feature-grid-subtext {
            min-width: 0;
          }
        }
      }

      @media (max-width: 40rem) {
        product-showcase.feature-item-showcase::after,
        .feature-item-showcase > .card-inner::after {
          display: none;
        }

        > .outer-content > .content > .feature-grid-background {
          grid-area: 1 / 1;
        }

        > .outer-content > .content > .feature-grid-content {
          background: #111;
          grid-area: 2 / 1;
          z-index: auto;

          > .outer-content,
          > .outer-content > .content {
            height: auto;
          }

          > .outer-content > .content {
            align-content: start;
            grid-template-columns: 1fr;
            padding: 1.75rem 1.25rem 2rem;
          }

          > .outer-content > .content > .eyebrow,
          > .outer-content > .content > .heading,
          > .outer-content > .content > .feature-grid-subtext {
            grid-column: 1;
            grid-row: auto;
          }

          .heading-inner {
            font-size: clamp(2rem, 9vw, 2.6rem);
          }

          .feature-grid-subtext {
            width: 100%;
          }

          .feature-grid-subtext p {
            white-space: normal;
          }
        }
      }
    }

    .feature-grid-mosaic {
      background-color: var(--color-bg);
      isolation: isolate;
      position: relative;
      z-index: 2;

      > .outer-content > .content {
        padding-top: clamp(4.5rem, 12vh, 7.5rem);
      }

      .feature-grid-content {
        padding-bottom: 0;
      }

      .bento-box-grid.feature-grid-grid {
        margin-top: 0;
      }

      .bento-box-grid-inner {
        gap: 0.5rem;
      }

      .bento-box-grid-item {
        padding: 0;
      }

      .feature-item.card {
        margin-top: 0;

        &:has(> a.card-inner)::before {
          content: none;
        }
      }

      .feature-item > .card-inner {
        background: #111;
        border: 0;
        border-radius: 0.75rem;
        min-height: 18rem;
      }

      .feature-item .before-content,
      .feature-item .before-content .image,
      .feature-item .before-content .image-inner,
      .feature-item .before-content picture,
      .feature-item .before-content img {
        height: 100%;
        margin: 0;
        width: 100%;
      }

      .feature-item .before-content {
        inset: 0;
        position: absolute;
        z-index: 0;
      }

      .feature-item .before-content img {
        object-fit: cover;
        transform: scale(1);
        transition: transform 700ms ease;
      }

      .feature-item:hover .before-content img {
        transform: scale(1.04);
      }

      .feature-item:has(.feature-hover-video):hover .before-content img {
        transform: none;
      }

      .feature-hover-video {
        height: 100%;
        inset: 0;
        object-fit: cover;
        opacity: 0;
        pointer-events: none;
        position: absolute;
        transition: opacity 180ms ease;
        width: 100%;
        z-index: 1;
      }

      .feature-item.is-playing .feature-hover-video {
        opacity: 1;
      }

      @media (prefers-reduced-motion: no-preference) {
        html.mosaic-motion &:not(.is-mosaic-in) .bento-box-grid-item {
          opacity: 0;
          transform: translateY(1.25rem);
        }

        html.mosaic-motion &.is-mosaic-in .bento-box-grid-item {
          animation: mosaic-rise 0.7s ease forwards;
        }

        html.mosaic-motion &.is-mosaic-in .bento-box-grid-item:nth-child(1) {
          animation-delay: 0s;
        }

        html.mosaic-motion &.is-mosaic-in .bento-box-grid-item:nth-child(2) {
          animation-delay: 0.12s;
        }

        html.mosaic-motion &.is-mosaic-in .bento-box-grid-item:nth-child(3) {
          animation-delay: 0.24s;
        }

        html.mosaic-motion &.is-mosaic-in .bento-box-grid-item:nth-child(4) {
          animation-delay: 0.36s;
        }

        html.mosaic-motion &.is-mosaic-in .bento-box-grid-item:nth-child(5) {
          animation-delay: 0.48s;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .feature-hover-video {
          transition: none;
        }
      }

      .feature-item > .card-inner > .card-outer-content {
        background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.82));
        inset: auto 0 0 0;
        padding: 2.5rem 2.4rem 1rem 1.05rem;
        pointer-events: none;
        position: absolute;
        z-index: 3;
      }

      .feature-item > .card-inner::after {
        bottom: 1rem;
        color: #fff;
        content: "↗";
        font-size: 0.95rem;
        line-height: 1;
        position: absolute;
        right: 0.95rem;
        z-index: 3;
      }

      .feature-title,
      .feature-item .heading,
      .feature-item .heading-text {
        color: #fff;
        font-size: clamp(1.05rem, 1.5vw, 1.35rem);
        margin: 0;
        text-shadow: 0 1px 10px rgba(0, 0, 0, 0.35);
      }

      .feature-description,
      .feature-description p {
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        color: rgba(255, 255, 255, 0.86);
        display: -webkit-box;
        line-clamp: 2;
        margin: 0.35rem 0 0;
        overflow: hidden;
      }

      @media (width >= 768px) {
        .feature-item > .card-inner {
          min-height: 26rem;
        }
      }

      @media (width < 768px) {
        .bento-box-grid-item {
          grid-column: 1 / -1;
          grid-row: auto;
        }
      }

    }

    @keyframes mosaic-rise {
      from {
        opacity: 0;
        transform: translateY(1.25rem);
      }

      to {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>
