---
interface Props {
  id?: string;
}
const { id = "grounding-experience" } = Astro.props;

// Anchors sit on copper routes in grounding-scene-copper.jpg (1280 × 720).
const annotations = [
  {
    id: "lightning",
    x: 152,
    y: 300,
    midX: 60,
    midY: 300,
    labelX: 60,
    labelY: 210,
    align: "start",
    label: "避雷組件",
    href: "/products/lightning-protection/",
  },
  {
    id: "joint",
    x: 400,
    y: 470,
    midX: 400,
    midY: 680,
    labelX: 400,
    labelY: 680,
    align: "center",
    label: "熱熔接型接地組件",
    href: "/products/grounding-components/",
  },
  {
    id: "rod",
    x: 680,
    y: 590,
    midX: 680,
    midY: 680,
    labelX: 680,
    labelY: 680,
    align: "center",
    label: "一般接地用材料",
    href: "/products/grounding-materials/",
  },
];
---

<section
  class="grounding-experience"
  id={id}
  aria-label="接地系統連接概念示意"
>
  <div class="grounding-track">
    <div class="grounding-sticky">
      <grounding-flow>
        <img
          class="scene-structures"
          src="/images/ccelect/grounding/grounding-scene-structures.jpg"
          alt="工廠、變電設備、鐵塔與地下接地網的線框示意；光點僅為連接概念示意，不代表實際電流方向或工程計算"
          width="1280"
          height="720"
          loading="lazy"
          decoding="async"
        />
        <img
          class="scene-powered"
          src="/images/ccelect/grounding/grounding-scene-powered.jpg"
          alt=""
          width="1280"
          height="720"
          loading="lazy"
          decoding="async"
          aria-hidden="true"
        />
        <img
          class="scene-copper"
          src="/images/ccelect/grounding/grounding-scene-copper.jpg"
          alt=""
          width="1280"
          height="720"
          loading="lazy"
          decoding="async"
          aria-hidden="true"
        />
        <canvas
          class="copper-canvas"
          width="1280"
          height="720"
          aria-hidden="true"
        ></canvas>
        <svg
          class="anno-overlay"
          viewBox="0 0 1280 720"
          aria-hidden="true"
          focusable="false"
        >
          {
            annotations.map((anno) => (
              <g data-annotation-line={anno.id}>
                <path
                  class="anno-leader"
                  d={`M ${anno.x} ${anno.y} L ${anno.midX} ${anno.midY} L ${anno.labelX} ${anno.labelY}`}
                  fill="none"
                  pathLength="1"
                />
                <circle
                  class="anno-ring"
                  cx={anno.x}
                  cy={anno.y}
                  r="7"
                />
                <circle
                  class="anno-anchor"
                  cx={anno.x}
                  cy={anno.y}
                  r="2.5"
                />
              </g>
            ))
          }
        </svg>
        <div class="anno-labels">
          {
            annotations.map((anno) => (
              <a
                class="anno-label"
                data-align={anno.align}
                href={anno.href}
                style={`left:${(anno.labelX / 1280) * 100}%; top:${(anno.labelY / 720) * 100}%;`}
              >
                <span class="anno-fig">FIG</span>
                <span class="anno-text">{anno.label}</span>
              </a>
            ))
          }
        </div>
        <button
          class="playback"
          type="button"
          aria-label="暫停動畫"
          aria-pressed="false"
          hidden
        >
          <svg
            class="pause-icon"
            viewBox="0 0 24 24"
            aria-hidden="true"
            ><path d="M8 6v12M16 6v12"></path></svg
          >
          <svg
            class="play-icon"
            viewBox="0 0 24 24"
            aria-hidden="true"
            ><path d="m9 5 10 7-10 7Z"></path></svg
          >
        </button>
      </grounding-flow>
    </div>
  </div>
</section>
<script>
  import "./grounding-flow";
</script>
<style>
  /* Defaults are the final frame so the scene still reads without JS or with reduced motion. */
  .grounding-experience {
    --structures-opacity: 1;
    --power-draw: 1;
    --copper-base: 1;
    --copper-gray: 0;
    --anno-progress: 1;
    background: #000;
    color: #e8e8e8;
  }
  .grounding-track {
    position: relative;
    min-height: 300vh;
  }
  .grounding-sticky {
    position: sticky;
    top: 0;
    display: grid;
    place-items: center;
    min-height: 100vh;
    padding-block: clamp(1.5rem, 4vh, 3rem);
    padding-inline: clamp(0.75rem, 3vw, 2rem);
    box-sizing: border-box;
  }
  grounding-flow {
    display: block;
    position: relative;
    width: min(100%, 1440px);
    aspect-ratio: 1280 / 720;
    margin-inline: auto;
  }
  grounding-flow > img,
  .copper-canvas,
  .anno-overlay,
  .anno-labels {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  grounding-flow > img {
    object-fit: contain;
    pointer-events: none;
  }
  .scene-structures {
    opacity: var(--structures-opacity);
  }
  .scene-powered {
    opacity: var(--structures-opacity);
    clip-path: inset(0 calc((1 - var(--power-draw)) * 100%) 0 0);
  }
  .scene-copper {
    opacity: var(--copper-base);
    filter: grayscale(var(--copper-gray)) brightness(calc(1 - var(--copper-gray) * 0.12));
  }
  .copper-canvas {
    display: none;
    pointer-events: none;
    filter: drop-shadow(0 0 2px rgb(255 150 70 / 90%)) drop-shadow(0 0 9px rgb(255 110 30 / 45%));
  }
  grounding-flow[data-ready] .copper-canvas {
    display: block;
  }
  .anno-overlay {
    overflow: visible;
    pointer-events: none;
  }
  .anno-leader {
    stroke: #9a9a9a;
    stroke-width: 1;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--anno-progress));
    vector-effect: non-scaling-stroke;
  }
  .anno-anchor {
    fill: #fff;
    opacity: var(--anno-progress);
  }
  .anno-ring {
    fill: none;
    stroke: #fff;
    stroke-width: 1;
    opacity: calc(var(--anno-progress) * 0.5);
    vector-effect: non-scaling-stroke;
  }
  .anno-labels {
    pointer-events: none;
  }
  .anno-label {
    position: absolute;
    display: grid;
    gap: 0.15rem;
    padding: 0.35rem 0;
    text-decoration: none;
    opacity: var(--anno-progress);
    pointer-events: auto;
  }
  .anno-label[data-align="start"] {
    transform: translate(0, -100%);
  }
  .anno-label[data-align="center"] {
    justify-items: center;
    transform: translate(-50%, 0);
  }
  .anno-label:hover .anno-text,
  .anno-label:focus-visible .anno-text {
    color: #fff;
  }
  .anno-label:focus-visible {
    outline: 1px solid #cfcfcf;
    outline-offset: 2px;
  }
  .anno-fig {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    color: #6f6f6f;
  }
  .anno-text {
    font-size: clamp(0.72rem, 1.3vw, 0.92rem);
    font-weight: 600;
    color: #d7d7d7;
    white-space: nowrap;
  }
  [hidden] {
    display: none !important;
  }
  .playback {
    position: absolute;
    left: 12px;
    bottom: 12px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid #4a4a4a;
    border-radius: 50%;
    color: #f0d2b0;
    background: #121212e6;
    cursor: pointer;
  }
  .playback:hover {
    color: #ffb06a;
    border-color: currentcolor;
  }
  .playback:focus-visible {
    outline: 2px solid #ffd4a0;
    outline-offset: -5px;
  }
  .playback svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentcolor;
    stroke-width: 2;
  }
  .play-icon,
  .playback[aria-pressed="true"] .pause-icon {
    display: none;
  }
  .playback[aria-pressed="true"] .play-icon {
    display: block;
  }
  @media (max-width: 720px) {
    .anno-fig {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .grounding-track {
      min-height: auto;
    }
    .grounding-sticky {
      position: static;
      min-height: auto;
    }
    .playback {
      display: none !important;
    }
  }
</style>
