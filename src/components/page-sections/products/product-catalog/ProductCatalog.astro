---
import Icon from "@core-elements/icon/Icon.astro";
import ProductsSide from "@navigation/products-side/ProductsSide.astro";
import ProductCatalogCard from "./ProductCatalogCard.astro";
import type { BreadcrumbItem, CatalogItem } from "./types";

interface Props {
  eyebrowText?: string;
  heading: string;
  subtext?: string;
  breadcrumbs?: BreadcrumbItem[];
  items?: CatalogItem[];
  helpHeading?: string;
  helpText?: string;
  helpLink?: string;
  helpLinkText?: string;
}

const {
  eyebrowText = "產品分類",
  heading,
  subtext,
  breadcrumbs = [],
  items = [],
  helpHeading = "不確定該選哪一項產品？",
  helpText = "提供使用環境、導體規格與需求數量，我們會協助確認適合的材料。",
  helpLink = "/contact/",
  helpLinkText = "取得選型協助",
} = Astro.props as Props;

// 在第一排產品後插入協助區塊，避免使用者迷失在長列表中。
const firstItems = items.slice(0, 3);
const remainingItems = items.slice(3);
---

<section
  class="product-catalog"
  data-theme="light"
>
  <div class="product-catalog-shell">
    <details class="catalog-sidebar">
      <summary>
        <span>瀏覽商品分類</span>
        <Icon
          name="chevron-down"
          size="none"
          aria-hidden="true"
        />
      </summary>
      <div class="catalog-sidebar-heading">商品櫥窗</div>
      <ProductsSide />
    </details>

    <div class="catalog-main">
      {
        breadcrumbs.length > 0 && (
          <nav
            class="catalog-breadcrumbs"
            aria-label="麵包屑"
          >
            {breadcrumbs.map((item, index) => (
              <span>
                {item.href ? <a href={item.href}>{item.label}</a> : <span>{item.label}</span>}
                {index < breadcrumbs.length - 1 && <span aria-hidden="true">/</span>}
              </span>
            ))}
          </nav>
        )
      }

      <header class="catalog-intro">
        <div>
          <p class="catalog-eyebrow">{eyebrowText}</p>
          <h1>{heading}</h1>
          {subtext && <p class="catalog-subtext">{subtext}</p>}
        </div>
        <p class="catalog-count">共 {items.length} 個產品分類</p>
      </header>

      <div class="catalog-grid">
        {
          firstItems.map((item) => (
            <ProductCatalogCard
              item={item}
              fallbackHref={helpLink}
            />
          ))
        }

        <aside class="catalog-help-card">
          <div class="catalog-help-icon">
            <Icon
              name="question-mark-circle"
              size="xl"
              aria-hidden="true"
            />
          </div>
          <div>
            <p class="catalog-help-label">選型協助</p>
            <h2>{helpHeading}</h2>
            <p>{helpText}</p>
          </div>
          <a href={helpLink}>
            {helpLinkText}
            <Icon
              name="arrow-right"
              size="none"
              aria-hidden="true"
            />
          </a>
        </aside>

        {
          remainingItems.map((item) => (
            <ProductCatalogCard
              item={item}
              fallbackHref={helpLink}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<style is:global>
  @layer page-sections {
    .product-catalog {
      background: var(--color-bg);
      color: var(--color-text);
      padding: clamp(2rem, 5vw, 5rem) clamp(1rem, 3vw, 3rem);

      .product-catalog-shell {
        display: grid;
        gap: clamp(2rem, 4vw, 4.5rem);
        grid-template-columns: minmax(13rem, 17rem) minmax(0, 1fr);
        margin: 0 auto;
        max-width: 92rem;
      }

      .catalog-sidebar {
        align-self: start;
        position: sticky;
        top: 7.5rem;

        > summary {
          display: none;
        }

        .catalog-sidebar-heading {
          border-bottom: 1px solid var(--color-border);
          color: var(--color-text-strong);
          font-size: var(--font-size-sm);
          font-weight: var(--font-weight-bold);
          letter-spacing: 0.08em;
          padding: 0 var(--spacing-md) var(--spacing-md);
          text-transform: uppercase;
        }

        .products-side-nav {
          margin-top: var(--spacing-sm);
        }

        .side-list > .nav-item > a,
        .side-list > .nav-item > .nav-item-trigger,
        .side-list > .nav-item > .nav-item-split {
          font-size: var(--font-size-sm);
        }

        .nav-list .nav-item > a {
          color: var(--color-text-muted);
          font-size: var(--font-size-sm);
          padding-block: var(--spacing-xs);
        }

        .nav-item a[aria-current="page"] .nav-item-label,
        .nav-item-split .nav-item-link[aria-current="page"] .nav-item-label {
          color: var(--color-text-brand);
          text-decoration: none;
        }
      }

      .catalog-main {
        min-width: 0;
      }

      .catalog-breadcrumbs {
        color: var(--color-text-muted);
        display: flex;
        flex-wrap: wrap;
        font-size: var(--font-size-sm);
        gap: var(--spacing-sm);

        > span {
          display: flex;
          gap: var(--spacing-sm);
        }

        a {
          color: inherit;
          text-decoration-color: var(--color-border-strong);
          text-underline-offset: 0.2em;
        }
      }

      .catalog-intro {
        align-items: end;
        border-bottom: 1px solid var(--color-border);
        display: flex;
        gap: var(--spacing-xl);
        justify-content: space-between;
        margin-top: clamp(2rem, 5vw, 4rem);
        padding-bottom: clamp(1.5rem, 3vw, 2.5rem);

        .catalog-eyebrow,
        .catalog-count {
          color: var(--color-text-brand);
          font-size: var(--font-size-sm);
          font-weight: var(--font-weight-bold);
          letter-spacing: 0.08em;
          margin: 0 0 var(--spacing-sm);
        }

        h1 {
          font-size: clamp(2rem, 4vw, 4rem);
          letter-spacing: -0.045em;
          line-height: 1.05;
          margin: 0;
        }

        .catalog-subtext {
          color: var(--color-text-muted);
          line-height: 1.75;
          margin: var(--spacing-lg) 0 0;
          max-width: 46rem;
        }

        .catalog-count {
          color: var(--color-text-muted);
          flex: 0 0 auto;
          letter-spacing: normal;
          margin-bottom: var(--spacing-xs);
        }
      }

      .catalog-grid {
        display: grid;
        gap: var(--spacing-lg);
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin-top: clamp(2rem, 4vw, 3.5rem);
      }

      .catalog-card {
        background: var(--color-bg-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        display: flex;
        flex-direction: column;
        min-width: 0;
        overflow: hidden;
        scroll-margin-top: 9rem;
        transition:
          border-color var(--animation-normal) ease,
          box-shadow var(--animation-normal) ease,
          transform var(--animation-normal) ease;

        &:hover {
          border-color: var(--color-border-strong);
          box-shadow: 0 1rem 2.5rem var(--color-shadow);
          transform: translateY(-0.25rem);
        }

        .catalog-card-media {
          aspect-ratio: 4 / 3;
          background:
            linear-gradient(145deg, var(--color-bg-muted), transparent), var(--color-bg-accent);
          overflow: hidden;

          > .image,
          > .image > .image-inner,
          picture,
          img {
            height: 100%;
            margin: 0;
            width: 100%;
          }

          img {
            object-fit: cover;
            transition: transform var(--animation-slow) ease;
          }

          &.icon-media {
            align-items: center;
            color: var(--color-text-brand);
            display: flex;
            justify-content: center;

            .icon {
              background: var(--color-bg-surface);
              border: 1px solid var(--color-border);
              border-radius: var(--radius-md);
              box-shadow: 0 0.75rem 2rem var(--color-shadow);
              padding: var(--spacing-lg);
            }
          }
        }

        &:hover .catalog-card-media img {
          transform: scale(1.035);
        }

        .catalog-card-body {
          display: flex;
          flex: 1;
          flex-direction: column;
          padding: clamp(1.25rem, 2vw, 1.75rem);

          .catalog-card-category {
            color: var(--color-text-brand);
            font-size: var(--font-size-xs);
            font-weight: var(--font-weight-bold);
            letter-spacing: 0.08em;
            margin: 0 0 var(--spacing-sm);
            text-transform: uppercase;
          }

          h2 {
            font-size: clamp(1.2rem, 2vw, 1.5rem);
            line-height: 1.3;
            margin: 0;
          }

          > p:not(.catalog-card-category) {
            color: var(--color-text-muted);
            font-size: var(--font-size-sm);
            line-height: 1.7;
            margin: var(--spacing-md) 0 0;
          }
        }

        .catalog-tags {
          display: flex;
          flex-wrap: wrap;
          gap: var(--spacing-xs);
          list-style: none;
          margin: var(--spacing-lg) 0 0;
          padding: 0;

          li {
            background: var(--color-bg-muted);
            border-radius: var(--radius-full);
            color: var(--color-text-muted);
            font-size: var(--font-size-xs);
            padding: 0.3rem 0.65rem;
          }
        }

        .catalog-card-link {
          align-items: center;
          color: var(--color-text-strong);
          display: flex;
          font-size: var(--font-size-sm);
          font-weight: var(--font-weight-bold);
          gap: var(--spacing-sm);
          margin-top: auto;
          padding-top: var(--spacing-xl);
          text-decoration: none;

          .icon {
            transition: transform var(--animation-normal) ease;
          }

          &:hover .icon {
            transform: translateX(0.25rem);
          }
        }
      }

      .catalog-help-card {
        align-items: center;
        background: var(--color-bg-inverse);
        border-radius: var(--radius-lg);
        color: var(--color-text-inverse);
        display: grid;
        gap: var(--spacing-xl);
        grid-column: 1 / -1;
        grid-template-columns: auto minmax(0, 1fr) auto;
        padding: clamp(1.5rem, 3vw, 2.5rem);

        .catalog-help-icon {
          align-items: center;
          background: color-mix(in srgb, white 10%, transparent);
          border-radius: var(--radius-full);
          display: flex;
          height: 3.5rem;
          justify-content: center;
          width: 3.5rem;
        }

        .catalog-help-label {
          color: var(--color-accent);
          font-size: var(--font-size-xs);
          font-weight: var(--font-weight-bold);
          letter-spacing: 0.08em;
          margin: 0 0 var(--spacing-xs);
          text-transform: uppercase;
        }

        h2 {
          color: inherit;
          font-size: clamp(1.25rem, 2vw, 1.75rem);
          margin: 0;
        }

        p:not(.catalog-help-label) {
          color: color-mix(in srgb, currentcolor 72%, transparent);
          font-size: var(--font-size-sm);
          margin: var(--spacing-sm) 0 0;
        }

        > a {
          align-items: center;
          background: var(--color-accent);
          border-radius: var(--radius-sm);
          color: var(--palette-brand-bg-dark);
          display: flex;
          font-size: var(--font-size-sm);
          font-weight: var(--font-weight-bold);
          gap: var(--spacing-sm);
          padding: 0.8rem 1rem;
          text-decoration: none;
          white-space: nowrap;
        }
      }
    }

    @media (max-width: 1100px) {
      .product-catalog {
        .product-catalog-shell {
          grid-template-columns: minmax(12rem, 14rem) minmax(0, 1fr);
        }

        .catalog-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }
    }

    @media (min-width: 801px) {
      .product-catalog .catalog-sidebar:not([open]) > .catalog-sidebar-heading,
      .product-catalog .catalog-sidebar:not([open]) > .products-side-nav {
        display: block;
      }
    }

    @media (max-width: 800px) {
      .product-catalog {
        padding-top: var(--spacing-xl);

        .product-catalog-shell {
          display: block;
        }

        .catalog-sidebar {
          background: var(--color-bg-surface);
          border: 1px solid var(--color-border);
          border-radius: var(--radius-md);
          margin-bottom: var(--spacing-xl);
          position: static;

          > summary {
            align-items: center;
            cursor: pointer;
            display: flex;
            font-weight: var(--font-weight-bold);
            justify-content: space-between;
            list-style: none;
            padding: var(--spacing-md);

            &::-webkit-details-marker {
              display: none;
            }
          }

          &[open] > summary .icon {
            transform: rotate(180deg);
          }

          .catalog-sidebar-heading {
            display: none;
          }

          .products-side-nav {
            border-top: 1px solid var(--color-border);
            margin: 0;
            max-height: 70vh;
            overflow: auto;
            padding: var(--spacing-sm);
          }
        }

        .catalog-intro {
          align-items: start;
          display: block;

          .catalog-count {
            margin: var(--spacing-lg) 0 0;
          }
        }
      }
    }

    @media (max-width: 560px) {
      .product-catalog {
        .catalog-grid {
          grid-template-columns: 1fr;
        }

        .catalog-help-card {
          align-items: start;
          grid-template-columns: auto 1fr;

          > a {
            grid-column: 1 / -1;
            justify-content: center;
          }
        }
      }
    }
  }
</style>
