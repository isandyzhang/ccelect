---
import Icon from "@core-elements/icon/Icon.astro";
import ProductsSide from "@navigation/products-side/ProductsSide.astro";
import ProductCatalogCard from "./ProductCatalogCard.astro";
import type { CatalogItem } from "./types";

interface Props {
  eyebrowText?: string;
  heading: string;
  subtext?: string;
  overviewTitle?: string;
  overview?: string[];
  overviewFeatures?: string[];
  productsHeading?: string;
  items?: CatalogItem[];
  helpHeading?: string;
  helpText?: string;
  helpLink?: string;
  helpLinkText?: string;
  countLabel?: string;
}

const {
  eyebrowText = "產品分類",
  heading,
  subtext,
  overviewTitle = "",
  overview = [],
  overviewFeatures = [],
  productsHeading = "",
  items = [],
  helpHeading = "不確定該選哪一項產品？",
  helpText = "提供使用環境、導體規格與需求數量，我們會協助確認適合的材料。",
  helpLink = "/contact/",
  helpLinkText = "取得選型協助",
  countLabel = "共 {count} 個產品分類",
} = Astro.props as Props;

const hasOverview = Boolean(overviewTitle || overview.length > 0 || overviewFeatures.length > 0);
const itemCountLabel = countLabel.replace("{count}", String(items.length));

// 在第一排產品後插入協助區塊，避免使用者迷失在長列表中。
const firstItems = items.slice(0, 3);
const remainingItems = items.slice(3);
---

<section
  class="product-catalog"
  data-theme="light"
>
  <div class="product-catalog-shell">
    <details
      class="catalog-sidebar"
      open
    >
      <summary>
        <span>瀏覽商品分類</span>
        <Icon
          name="chevron-down"
          size="none"
          aria-hidden="true"
        />
      </summary>
      <div class="catalog-sidebar-heading">商品櫥窗</div>
      <ProductsSide />
    </details>

    <div class="catalog-main">
      <header class="catalog-intro">
        <div>
          <p class="catalog-eyebrow">{eyebrowText}</p>
          <h1>{heading}</h1>
          {subtext && <p class="catalog-subtext">{subtext}</p>}
        </div>
        <p class="catalog-count">{itemCountLabel}</p>
      </header>

      {
        hasOverview && (
          <section
            class="catalog-overview"
            aria-label={overviewTitle || heading}
          >
            {overviewTitle && <h2>{overviewTitle}</h2>}
            {overview.length > 0 && (
              <div class="catalog-overview-copy">
                {overview.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
            )}
            {overviewFeatures.length > 0 && (
              <ul class="catalog-overview-features">
                {overviewFeatures.map((feature) => (
                  <li>{feature}</li>
                ))}
              </ul>
            )}
          </section>
        )
      }

      {
        productsHeading && (
          <h2 class="catalog-products-heading">{productsHeading}</h2>
        )
      }

      <div class="catalog-grid">
        {
          firstItems.map((item) => (
            <ProductCatalogCard
              item={item}
              fallbackHref={helpLink}
            />
          ))
        }

        <aside class="catalog-help-card">
          <div class="catalog-help-icon">
            <Icon
              name="question-mark-circle"
              size="xl"
              aria-hidden="true"
            />
          </div>
          <div>
            <p class="catalog-help-label">選型協助</p>
            <h2>{helpHeading}</h2>
            <p>{helpText}</p>
          </div>
          <a href={helpLink}>
            {helpLinkText}
            <Icon
              name="arrow-right"
              size="none"
              aria-hidden="true"
            />
          </a>
        </aside>

        {
          remainingItems.map((item) => (
            <ProductCatalogCard
              item={item}
              fallbackHref={helpLink}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<style is:global>
  @layer page-sections {
    .product-catalog {
      background: var(--color-bg);
      color: var(--color-text);
      padding: clamp(2rem, 5vw, 5rem) clamp(1rem, 3vw, 3rem);

      .product-catalog-shell {
        display: grid;
        gap: clamp(2rem, 4vw, 4.5rem);
        grid-template-columns: minmax(13rem, 17rem) minmax(0, 1fr);
        margin: 0 auto;
        max-width: 92rem;
      }

      .catalog-sidebar {
        align-self: start;
        position: sticky;
        top: 7.5rem;

        > summary {
          display: none;
        }

        .catalog-sidebar-heading {
          border-bottom: 1px solid var(--color-border);
          color: var(--color-text-strong);
          font-size: var(--font-size-sm);
          font-weight: var(--font-weight-bold);
          letter-spacing: 0.08em;
          padding: 0 var(--spacing-md) var(--spacing-md);
          text-transform: uppercase;
        }

        .products-side-nav {
          margin-top: var(--spacing-sm);
        }

        .side-list > .nav-item > a,
        .side-list > .nav-item > .nav-item-trigger,
        .side-list > .nav-item > .nav-item-split {
          font-size: var(--font-size-sm);
        }

        .nav-list .nav-item > a {
          color: var(--color-text-muted);
          font-size: var(--font-size-sm);
          padding-block: var(--spacing-xs);
        }

        .nav-item a[aria-current="page"] .nav-item-label,
        .nav-item-split .nav-item-link[aria-current="page"] .nav-item-label {
          color: var(--color-text-brand);
          text-decoration: none;
        }
      }

      .catalog-main {
        min-width: 0;
      }

      .catalog-intro {
        align-items: end;
        border-bottom: 1px solid var(--color-border);
        display: flex;
        gap: var(--spacing-xl);
        justify-content: space-between;
        padding-bottom: clamp(1.5rem, 3vw, 2.5rem);

        .catalog-eyebrow,
        .catalog-count {
          color: var(--color-text-brand);
          font-size: var(--font-size-sm);
          font-weight: var(--font-weight-bold);
          letter-spacing: 0.08em;
          margin: 0 0 var(--spacing-sm);
        }

        h1 {
          font-size: clamp(2rem, 4vw, 4rem);
          letter-spacing: -0.045em;
          line-height: 1.05;
          margin: 0;
        }

        .catalog-subtext {
          color: var(--color-text-muted);
          line-height: 1.75;
          margin: var(--spacing-lg) 0 0;
          max-width: 46rem;
        }

        .catalog-count {
          color: var(--color-text-muted);
          flex: 0 0 auto;
          letter-spacing: normal;
          margin-bottom: var(--spacing-xs);
        }
      }

      .catalog-overview {
        border-bottom: 1px solid var(--color-border);
        display: grid;
        gap: 1rem;
        margin-top: clamp(1.5rem, 3vw, 2.5rem);
        padding-bottom: clamp(1.5rem, 3vw, 2.5rem);

        h2 {
          color: var(--color-text-strong);
          font-size: clamp(1.25rem, 2.5vw, 1.75rem);
          margin: 0;
        }
      }

      .catalog-overview-copy {
        display: grid;
        gap: 0.85rem;
        max-width: 46rem;

        p {
          color: var(--color-text);
          line-height: 1.75;
          margin: 0;
        }
      }

      .catalog-overview-features {
        display: grid;
        gap: 0.65rem;
        list-style: none;
        margin: 0.25rem 0 0;
        max-width: 46rem;
        padding: 0;

        li {
          border-left: 3px solid var(--color-bg-brand);
          color: var(--color-text);
          line-height: 1.6;
          padding-left: 0.85rem;
        }
      }

      .catalog-products-heading {
        color: var(--color-text-strong);
        font-size: clamp(1.25rem, 2.5vw, 1.75rem);
        margin: clamp(1.75rem, 3vw, 2.75rem) 0 0;
      }

      .catalog-grid {
        display: grid;
        gap: var(--spacing-lg);
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin-top: clamp(1.25rem, 3vw, 2rem);
      }

      .catalog-help-card {
        align-items: center;
        background: var(--color-bg-inverse);
        border-radius: var(--radius-lg);
        color: var(--color-text-inverse);
        display: grid;
        gap: var(--spacing-xl);
        grid-column: 1 / -1;
        grid-template-columns: auto minmax(0, 1fr) auto;
        padding: clamp(1.5rem, 3vw, 2.5rem);

        .catalog-help-icon {
          align-items: center;
          background: color-mix(in srgb, white 10%, transparent);
          border-radius: var(--radius-full);
          display: flex;
          height: 3.5rem;
          justify-content: center;
          width: 3.5rem;
        }

        .catalog-help-label {
          color: var(--color-accent);
          font-size: var(--font-size-xs);
          font-weight: var(--font-weight-bold);
          letter-spacing: 0.08em;
          margin: 0 0 var(--spacing-xs);
          text-transform: uppercase;
        }

        h2 {
          color: inherit;
          font-size: clamp(1.25rem, 2vw, 1.75rem);
          margin: 0;
        }

        p:not(.catalog-help-label) {
          color: color-mix(in srgb, currentcolor 72%, transparent);
          font-size: var(--font-size-sm);
          margin: var(--spacing-sm) 0 0;
        }

        > a {
          align-items: center;
          background: var(--color-accent);
          border-radius: var(--radius-sm);
          color: var(--palette-brand-bg-dark);
          display: flex;
          font-size: var(--font-size-sm);
          font-weight: var(--font-weight-bold);
          gap: var(--spacing-sm);
          padding: 0.8rem 1rem;
          text-decoration: none;
          white-space: nowrap;
        }
      }
    }

    @media (max-width: 1100px) {
      .product-catalog {
        .product-catalog-shell {
          grid-template-columns: minmax(12rem, 14rem) minmax(0, 1fr);
        }

        .catalog-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }
    }

    @media (min-width: 801px) {
      /* 桌面固定顯示側欄；closed details 會把高度壓成 0 */
      .product-catalog .catalog-sidebar {
        display: block;
      }

      .product-catalog .catalog-sidebar > summary {
        display: none;
      }

      .product-catalog .catalog-sidebar > .catalog-sidebar-heading,
      .product-catalog .catalog-sidebar > .products-side-nav {
        display: block;
      }
    }

    @media (max-width: 800px) {
      .product-catalog {
        padding-top: var(--spacing-xl);

        .product-catalog-shell {
          display: block;
        }

        .catalog-sidebar {
          background: var(--color-bg-surface);
          border: 1px solid var(--color-border);
          border-radius: var(--radius-md);
          margin-bottom: var(--spacing-xl);
          position: static;

          > summary {
            align-items: center;
            cursor: pointer;
            display: flex;
            font-weight: var(--font-weight-bold);
            justify-content: space-between;
            list-style: none;
            padding: var(--spacing-md);

            &::-webkit-details-marker {
              display: none;
            }
          }

          &[open] > summary .icon {
            transform: rotate(180deg);
          }

          .catalog-sidebar-heading {
            display: none;
          }

          .products-side-nav {
            border-top: 1px solid var(--color-border);
            margin: 0;
            max-height: 70vh;
            overflow: auto;
            padding: var(--spacing-sm);
          }
        }

        .catalog-intro {
          align-items: start;
          display: block;

          .catalog-count {
            margin: var(--spacing-lg) 0 0;
          }
        }
      }
    }

    @media (max-width: 560px) {
      .product-catalog {
        .catalog-grid {
          grid-template-columns: 1fr;
        }

        .catalog-help-card {
          align-items: start;
          grid-template-columns: auto 1fr;

          > a {
            grid-column: 1 / -1;
            justify-content: center;
          }
        }
      }
    }
  }
</style>
