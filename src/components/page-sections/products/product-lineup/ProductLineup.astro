---
import Image from "@core-elements/image/Image.astro";
import { defaultLocale, type Locale } from "@i18n/config";
import { experienceText, localeFromPath } from "@i18n/experience";

interface NavItem {
  title: string;
  image?: string;
  imageAlt?: string;
  href: string;
  badge?: string;
}

interface LineupItem {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  href: string;
  ctaText?: string;
  secondaryHref?: string;
  secondaryText?: string;
  tone?: "dark" | "blue" | "gray" | "warm";
}

interface Family {
  id?: string;
  title: string;
  lineupHeading?: string;
  catalogHref?: string;
  catalogLabel?: string;
  navItems?: NavItem[];
  items?: LineupItem[];
}

interface HelpTile {
  title: string;
  description?: string;
  href: string;
  linkText?: string;
}

interface Props {
  families?: Family[];
  helpHeading?: string;
  helpTiles?: HelpTile[];
  class?: string;
}

const locale = localeFromPath(Astro.url.pathname) as Locale;
const copy = experienceText[locale] ?? experienceText[defaultLocale];

const { families = [], helpHeading = "", helpTiles = [], class: className } = Astro.props as Props;
---

<section
  class:list={["product-lineup", className]}
  data-theme="light"
  data-product-lineup
>
  {
    families.map((family, familyIndex) => {
      const navItems = family.navItems ?? [];
      const items = family.items ?? [];
      const TitleTag = familyIndex === 0 ? "h1" : "h2";

      return (
        <div
          class="product-lineup__family"
          id={family.id}
        >
          <div class="product-lineup__family-head">
            <div>
              <TitleTag class="product-lineup__family-title">{family.title}</TitleTag>
              {family.lineupHeading && (
                <p class="product-lineup__tagline">{family.lineupHeading}</p>
              )}
            </div>
            {family.catalogHref && (
              <a
                class="product-lineup__catalog"
                href={family.catalogHref}
              >
                {family.catalogLabel || copy.viewProduct}
                <span aria-hidden="true"> ↗</span>
              </a>
            )}
          </div>

          {navItems.length > 0 && (
            <nav
              class="product-lineup__chapternav"
              aria-label={family.title}
            >
              <ul class="product-lineup__chapternav-list">
                {navItems.map((item) => (
                  <li>
                    <a
                      class="product-lineup__chapternav-item"
                      href={item.href}
                    >
                      {item.image && (
                        <span class="product-lineup__chapternav-media">
                          <Image
                            source={item.image}
                            alt={item.imageAlt || item.title}
                            sizes="192px"
                          />
                        </span>
                      )}
                      <span class="product-lineup__chapternav-label">{item.title}</span>
                      {item.badge && (
                        <span class="product-lineup__chapternav-badge">{item.badge}</span>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )}

          {items.length > 0 && (
            <div class="product-lineup__gallery">
              <div
                class="product-lineup__scroller"
                data-lineup-scroller
                tabindex="0"
                role="region"
                aria-label={family.title}
              >
                <ul class="product-lineup__track">
                  {items.map((item) => (
                    <li class="product-lineup__card">
                      <div class="product-lineup__card-inner">
                        {item.image && (
                          <div class="product-lineup__card-media">
                            <Image
                              source={item.image}
                              alt={item.imageAlt || item.title}
                              sizes="(max-width: 40rem) 90vw, (max-width: 56rem) 45vw, 25rem"
                            />
                          </div>
                        )}
                        <h3 class="product-lineup__card-title">{item.title}</h3>
                        {item.description && (
                          <p class="product-lineup__card-copy">{item.description}</p>
                        )}
                        <div class="product-lineup__card-ctas">
                          <a
                            class="product-lineup__card-primary"
                            href={item.href}
                          >
                            {item.ctaText || copy.learnMore}
                          </a>
                        </div>
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          )}
        </div>
      );
    })
  }

  {
    helpTiles.length > 0 && (
      <div class="product-lineup__help">
        {helpHeading && <h2 class="product-lineup__help-title">{helpHeading}</h2>}
        <ul class="product-lineup__help-grid">
          {helpTiles.map((tile) => (
            <li class="product-lineup__help-tile">
              <h3>{tile.title}</h3>
              {tile.description && <p>{tile.description}</p>}
              <a href={tile.href}>{tile.linkText || copy.learnMore}</a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</section>
<script>
  let teardown: (() => void) | undefined;

  const init = () => {
    teardown?.();
    const events = new AbortController();
    const { signal } = events;
    const scrollers = document.querySelectorAll<HTMLElement>("[data-lineup-scroller]");
    const observers: ResizeObserver[] = [];

    for (const scroller of scrollers) {
      const update = () => {
        const more = scroller.scrollLeft + scroller.clientWidth < scroller.scrollWidth - 4;

        scroller.classList.toggle("has-more", more);
      };

      update();
      scroller.addEventListener("scroll", update, { passive: true, signal });
      const observer = new ResizeObserver(update);

      observer.observe(scroller);
      observers.push(observer);
    }

    teardown = () => {
      events.abort();
      for (const observer of observers) observer.disconnect();
    };
  };

  document.addEventListener("astro:page-load", init);
  init();
</script>
<style is:global>
  @layer page-sections {
    .product-lineup {
      --lineup-bg: #fff;
      --lineup-soft: #f5f5f7;
      --lineup-ink: #1d1d1f;
      --lineup-muted: #6e6e73;
      --lineup-link: #0066cc;
      --lineup-gutter: clamp(1.25rem, 4vw, 2.5rem);

      background: var(--lineup-bg);
      color: var(--lineup-ink);
      overflow: clip;
      padding-block: clamp(1.5rem, 4vw, 2.5rem) clamp(3rem, 8vw, 5.5rem);
    }

    .product-lineup__family + .product-lineup__family {
      border-top: 1px solid #d2d2d7;
      margin-top: clamp(3rem, 7vw, 5rem);
      padding-top: clamp(2.5rem, 6vw, 4rem);
    }

    .product-lineup__family-head {
      align-items: start;
      display: flex;
      gap: 1.5rem;
      justify-content: space-between;
      margin-inline: auto;
      max-width: 85rem;
      padding-inline: var(--lineup-gutter);
    }

    .product-lineup__family-title {
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 600;
      letter-spacing: -0.03em;
      line-height: 1.08;
      margin: 0;
      text-align: start;
    }

    .product-lineup__chapternav {
      margin: 2rem auto 0;
      max-width: 85rem;
      padding-inline: var(--lineup-gutter);
    }

    .product-lineup__chapternav-list {
      display: grid;
      gap: 1.5rem;
      grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .product-lineup__chapternav-item {
      align-items: center;
      color: var(--lineup-ink);
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      min-width: 0;
      text-align: center;
      text-decoration: none;
    }

    .product-lineup__chapternav-item:hover .product-lineup__chapternav-label,
    .product-lineup__chapternav-item:focus-visible .product-lineup__chapternav-label {
      color: var(--lineup-link);
    }

    .product-lineup__chapternav-media {
      align-items: center;
      display: flex;
      height: 7.5rem;
      justify-content: center;
      max-width: 10rem;
      width: 100%;
    }

    .product-lineup__chapternav-media .image,
    .product-lineup__chapternav-media .image-inner {
      display: flex;
      height: 100%;
      width: 100%;
    }

    .product-lineup__chapternav-media picture,
    .product-lineup__chapternav-media img {
      height: 100%;
      margin: auto;
      max-height: 100%;
      max-width: 100%;
      object-fit: contain;
      width: auto;
    }

    .product-lineup__chapternav-label {
      font-size: clamp(0.8125rem, 1.8vw, 0.9375rem);
      font-weight: 600;
      letter-spacing: -0.01em;
      line-height: 1.3;
    }

    .product-lineup__chapternav-badge {
      color: #bf4800;
      font-size: clamp(0.6875rem, 1.5vw, 0.75rem);
      font-weight: 400;
      line-height: 1;
    }

    /* Explore the lineup gallery — gray band separates from chapternav */
    .product-lineup__gallery {
      background: var(--lineup-soft);
      margin-top: 2.5rem;
      padding-block: 2.5rem;
      width: 100%;
    }

    .product-lineup__scroller {
      --lineup-gap: 1.5rem;
      --lineup-count: 3.5;
      --lineup-card: calc(
        (100% - (var(--lineup-count) - 0.5) * var(--lineup-gap)) / var(--lineup-count)
      );
      --peek: calc(
        (100% - var(--lineup-gutter) - (var(--lineup-count) - 0.5) * var(--lineup-gap)) /
          (var(--lineup-count) * 2)
      );

      margin-inline: auto;
      max-width: 85rem;
      padding-inline: var(--lineup-gutter) 0;
      padding-bottom: 1rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-padding-inline-start: var(--lineup-gutter);
      scroll-snap-type: x mandatory;
      scrollbar-width: thin;
      scrollbar-color: #c2c2c8 transparent;
    }

    .product-lineup__scroller.has-more {
      -webkit-mask-image: linear-gradient(to right, #000 calc(100% - var(--peek)), transparent);
      mask-image: linear-gradient(to right, #000 calc(100% - var(--peek)), transparent);
    }

    .product-lineup__scroller:focus-visible {
      outline: 2px solid var(--lineup-link);
      outline-offset: -2px;
    }

    .product-lineup__track {
      display: flex;
      gap: var(--lineup-gap);
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .product-lineup__track::after {
      content: "";
      flex: 0 0 var(--lineup-gutter);
    }

    .product-lineup__card {
      flex: 0 0 var(--lineup-card);
      min-width: 0;
      scroll-snap-align: start;
    }

    .product-lineup__card-inner {
      align-items: center;
      display: flex;
      flex-direction: column;
      height: 100%;
      text-align: center;
    }

    /* One gray only — transparent cutouts float on the soft band */
    .product-lineup__card-media {
      background: transparent;
      height: clamp(15rem, 24vw, 20rem);
      margin-bottom: 1.25rem;
      padding: 1rem;
      width: 100%;
    }

    .product-lineup__card-media .image {
      background: transparent;
      margin-top: 0;
    }

    .product-lineup__card-media .image,
    .product-lineup__card-media .image-inner {
      display: flex;
      height: 100%;
      width: 100%;
    }

    .product-lineup__card-media picture,
    .product-lineup__card-media img {
      background: transparent;
      height: 100%;
      margin: auto;
      max-height: 100%;
      max-width: 100%;
      object-fit: contain;
      width: auto;
    }

    .product-lineup__card-title {
      font-size: clamp(1.25rem, 2vw, 1.5rem);
      font-weight: 600;
      letter-spacing: -0.02em;
      line-height: 1.15;
      margin: 0 0 0.55rem;
    }

    .product-lineup__card-copy {
      color: var(--lineup-muted);
      font-size: clamp(1rem, 2.2vw, 1.125rem);
      line-height: 1.45;
      margin: 0 auto 1.15rem;
      max-width: 24rem;
      min-height: 2.8em;
    }

    .product-lineup__card-ctas {
      align-items: center;
      display: flex;
      flex-wrap: wrap;
      gap: 0.85rem 1.1rem;
      justify-content: center;
      margin-top: auto;
      padding-top: 0.75rem;
    }

    .product-lineup__card-primary {
      background: var(--lineup-link);
      border-radius: 999px;
      color: #fff;
      font-size: clamp(0.9375rem, 1.8vw, 1.0625rem);
      font-weight: 400;
      line-height: 1;
      padding: 0.7rem 1.25rem;
      text-decoration: none;
    }

    .product-lineup__card-primary:hover,
    .product-lineup__card-primary:focus-visible {
      opacity: 0.88;
    }

    .product-lineup__help {
      border-top: 1px solid #d2d2d7;
      margin-inline: auto;
      margin-top: clamp(3rem, 7vw, 5rem);
      max-width: 85rem;
      padding-inline: var(--lineup-gutter);
      padding-top: clamp(2.5rem, 6vw, 3.5rem);
    }

    .product-lineup__help-title {
      font-size: clamp(1.65rem, 3.8vw, 2.4rem);
      font-weight: 600;
      letter-spacing: -0.02em;
      margin: 0 0 1.5rem;
      text-align: center;
    }

    .product-lineup__help-grid {
      display: grid;
      gap: 1rem;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .product-lineup__help-tile {
      background: var(--lineup-soft);
      border-radius: 1.25rem;
      padding: 1.75rem 1.35rem;
      text-align: center;
    }

    .product-lineup__help-tile h3 {
      font-size: clamp(1.125rem, 2.4vw, 1.35rem);
      font-weight: 600;
      letter-spacing: -0.015em;
      margin: 0 0 0.55rem;
    }

    .product-lineup__help-tile p {
      color: var(--lineup-muted);
      font-size: clamp(1rem, 2vw, 1.0625rem);
      line-height: 1.45;
      margin: 0 0 0.95rem;
    }

    .product-lineup__help-tile a {
      color: var(--lineup-link);
      font-size: clamp(0.9375rem, 1.8vw, 1.0625rem);
      text-decoration: none;
    }

    .product-lineup__help-tile a:hover,
    .product-lineup__help-tile a:focus-visible {
      text-decoration: underline;
      text-underline-offset: 0.18em;
    }

    .product-lineup__tagline {
      color: var(--lineup-muted);
      font-size: clamp(1.125rem, 2.2vw, 1.5rem);
      line-height: 1.5;
      margin: 0.75rem 0 0;
    }

    .product-lineup__catalog {
      color: var(--lineup-link);
      flex-shrink: 0;
      padding-block: 0.75rem;
      text-underline-offset: 0.25em;
    }

    @media (max-width: 56rem) {
      .product-lineup__scroller {
        --lineup-count: 2.5;
      }

      .product-lineup__help-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 40rem) {
      .product-lineup__family-head {
        flex-direction: column;
        gap: 0.5rem;
      }

      .product-lineup__chapternav-list {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.25rem 0.75rem;
      }

      .product-lineup__chapternav-media {
        height: 5rem;
      }

      .product-lineup__card {
        flex-basis: 86%;
      }

      .product-lineup__scroller {
        --peek: 14%;
      }

      .product-lineup__card-media {
        height: 17.5rem;
      }
    }

    @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
      .product-lineup__chapternav-media img,
      .product-lineup__card-media img {
        transition: transform 240ms ease-out;
      }

      .product-lineup__chapternav-item:hover .product-lineup__chapternav-media img,
      .product-lineup__chapternav-item:focus-visible .product-lineup__chapternav-media img,
      .product-lineup__card:hover .product-lineup__card-media img,
      .product-lineup__card:focus-within .product-lineup__card-media img {
        transform: translateY(-4px) scale(1.015);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .product-lineup__scroller {
        scroll-behavior: auto;
      }
    }
  }
</style>
