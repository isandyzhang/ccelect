---
import Image from "@core-elements/image/Image.astro";
import { slugifyLabel } from "@components/utils/slugify";

const {
  id = "",
  label,
  imageSource = "",
  imageAlt = "",
  heading = "",
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

if (!htmlAttributes.id && (id || label)) {
  htmlAttributes.id = id || slugifyLabel(label);
}
---

<section
  class:list={["hero-image-banner", className]}
  {...htmlAttributes}
>
  <Image
    class="hero-image-banner__media"
    source={imageSource}
    alt={imageAlt}
    priority={true}
    background={true}
    positionVertical="center"
    positionHorizontal="center"
    {...(useDefaultEditableBinding
      ? { "data-prop-src": "imageSource", "data-prop-alt": "imageAlt" }
      : {})}
  />
  <div
    class="hero-image-banner__overlay"
    aria-hidden="true"
  />
  {
    heading && (
      <h1
        class="hero-image-banner__title"
        data-editable={useDefaultEditableBinding ? "text" : undefined}
        data-type={useDefaultEditableBinding ? "text" : undefined}
        data-prop={useDefaultEditableBinding ? "heading" : undefined}
        set:html={heading}
      />
    )
  }
</section>

<style is:global>
  @layer page-sections {
    .hero-image-banner {
      isolation: isolate;
      margin-top: calc(var(--spacing-nav-height) * -1);
      min-height: 100vh;
      min-height: 100dvh;
      overflow: hidden;
      position: relative;
      width: 100%;

      > .hero-image-banner__media {
        inset: 0;
        margin-top: 0;
        position: absolute;
        z-index: 0;
      }

      > .hero-image-banner__overlay {
        background-color: rgba(23, 34, 52, 0.45);
        inset: 0;
        pointer-events: none;
        position: absolute;
        z-index: 1;
      }

      > .hero-image-banner__title {
        color: #fff;
        font-family: var(--font-headings);
        font-size: var(--font-size-heading-2xl);
        font-weight: var(--font-weight-bold);
        left: 50%;
        line-height: 1.25;
        margin: 0;
        padding: var(--spacing-2xl) var(--spacing-xl);
        position: absolute;
        text-align: center;
        text-shadow: 0 2px 16px rgba(23, 34, 52, 0.55);
        top: 50%;
        transform: translate(-50%, -50%);
        width: max-content;
        max-width: calc(100% - 2 * var(--spacing-xl));
        z-index: 2;
      }

      @media (width < 768px) {
        > .hero-image-banner__title {
          font-size: var(--font-size-heading-xl);
          max-width: calc(100% - 2 * var(--spacing-lg));
          padding: var(--spacing-xl) var(--spacing-lg);
        }
      }
    }
  }
</style>
