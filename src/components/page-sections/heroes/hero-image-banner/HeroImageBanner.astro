---
import Image from "@core-elements/image/Image.astro";
import Video from "@core-elements/video/Video.astro";
import { slugifyLabel } from "@components/utils/slugify";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

const {
  id = "",
  label,
  imageSource = "",
  imageAlt = "",
  videoSource = "",
  heading = "",
  subtext = "",
  buttonSections = [],
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

if (!htmlAttributes.id && (id || label)) {
  htmlAttributes.id = id || slugifyLabel(label);
}

const hasButtons = Array.isArray(buttonSections) && buttonSections.length > 0;
const hasCopy = Boolean(heading || subtext || hasButtons);
const hasVideo = typeof videoSource === "string" && videoSource.trim() !== "";
---

<section
  class:list={["hero-image-banner", hasVideo && "has-video", className]}
  {...htmlAttributes}
>
  <Image
    class="hero-image-banner__media"
    source={imageSource}
    alt={imageAlt}
    priority={true}
    background={true}
    positionVertical="center"
    positionHorizontal="center"
    {...(useDefaultEditableBinding
      ? { "data-prop-src": "imageSource", "data-prop-alt": "imageAlt" }
      : {})}
  />
  {
    hasVideo && (
      <Video
        class="hero-image-banner__video"
        type="local-source"
        source={videoSource}
        thumbnail={imageSource}
        background={true}
      />
    )
  }
  <div
    class="hero-image-banner__overlay"
    aria-hidden="true"
  />
  {
    hasCopy && (
      <div class="hero-image-banner__copy">
        {heading && (
          <h1
            class="hero-image-banner__title"
            data-editable={useDefaultEditableBinding ? "text" : undefined}
            data-type={useDefaultEditableBinding ? "text" : undefined}
            data-prop={useDefaultEditableBinding ? "heading" : undefined}
            set:html={heading}
          />
        )}
        {subtext && (
          <p
            class="hero-image-banner__subtext"
            data-editable={useDefaultEditableBinding ? "text" : undefined}
            data-type={useDefaultEditableBinding ? "text" : undefined}
            data-prop={useDefaultEditableBinding ? "subtext" : undefined}
          >
            {subtext}
          </p>
        )}
        {hasButtons && (
          <ButtonGroup
            class="hero-image-banner__actions"
            buttonSections={buttonSections}
            alignmentHorizontal="start"
            useDefaultEditableBinding={useDefaultEditableBinding}
            data-children-prop="buttonSections"
          />
        )}
      </div>
    )
  }
</section>

<style is:global>
  @layer page-sections {
    @keyframes hero-image-banner-rise {
      from {
        opacity: 0;
        transform: translate3d(0, 2.5rem, 0);
      }

      to {
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }
    }

    .hero-image-banner {
      isolation: isolate;
      margin-top: calc(var(--spacing-nav-height) * -1);
      min-height: 100vh;
      min-height: 100dvh;
      overflow: hidden;
      position: relative;
      width: 100%;

      > .hero-image-banner__media {
        inset: 0;
        margin-top: 0;
        position: absolute;
        z-index: 0;
      }

      > .hero-image-banner__video {
        inset: 0;
        margin-top: 0;
        position: absolute;
        z-index: 0;
      }

      &.has-video > .hero-image-banner__media {
        z-index: 0;
      }

      &.has-video > .hero-image-banner__video {
        z-index: 1;
      }

      > .hero-image-banner__overlay {
        background-color: rgba(23, 34, 52, 0.45);
        inset: 0;
        pointer-events: none;
        position: absolute;
        z-index: 2;
      }

      > .hero-image-banner__copy {
        bottom: auto;
        display: flex;
        flex-direction: column;
        gap: var(--spacing-md);
        left: clamp(var(--spacing-xl), 8vw, 6rem);
        max-width: min(42rem, calc(100% - 2 * var(--spacing-xl)));
        padding: var(--spacing-2xl) var(--spacing-xl);
        position: absolute;
        text-align: left;
        top: 58%;
        transform: translateY(-30%);
        z-index: var(--layer-2);
      }

      .hero-image-banner__title,
      .hero-image-banner__subtext,
      .hero-image-banner__actions {
        animation: hero-image-banner-rise 900ms cubic-bezier(0.22, 1, 0.36, 1) both;
      }

      .hero-image-banner__title {
        animation-delay: 120ms;
        color: #fff !important;
        font-family: var(--font-headings);
        font-size: var(--font-size-heading-2xl);
        font-weight: var(--font-weight-bold);
        line-height: 1.25;
        margin: 0;
        text-shadow: 0 2px 16px rgba(23, 34, 52, 0.55);
      }

      .hero-image-banner__subtext {
        animation-delay: 280ms;
        color: rgba(255, 255, 255, 0.9) !important;
        font-family: var(--font-body);
        font-size: var(--font-size-lg);
        line-height: 1.6;
        margin: 0;
        max-width: 36rem;
        text-shadow: 0 1px 8px rgba(23, 34, 52, 0.45);
      }

      .hero-image-banner__actions {
        animation-delay: 440ms;
        margin-top: var(--spacing-sm);
        width: auto;
      }

      .hero-image-banner__actions > .button-group__items {
        gap: var(--spacing-md);
      }

      .hero-image-banner__actions .button-inner.variant-secondary {
        background-color: rgba(255, 255, 255, 0.12);
        border-color: rgba(255, 255, 255, 0.55);
        color: #fff;
      }

      .hero-image-banner__actions .button-inner.variant-secondary:hover {
        background-color: rgba(255, 255, 255, 0.22);
        border-color: #fff;
        color: #fff;
      }

      @media (width < 768px) {
        > .hero-image-banner__copy {
          max-width: calc(100% - 2 * var(--spacing-lg));
          padding: var(--spacing-xl) var(--spacing-lg);
        }

        .hero-image-banner__title {
          font-size: var(--font-size-heading-xl);
        }

        .hero-image-banner__subtext {
          font-size: var(--font-size-md);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .hero-image-banner__title,
        .hero-image-banner__subtext,
        .hero-image-banner__actions {
          animation: none;
        }
      }
    }
  }
</style>
