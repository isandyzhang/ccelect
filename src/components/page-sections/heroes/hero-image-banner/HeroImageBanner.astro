---
import Image from "@core-elements/image/Image.astro";
import Video from "@core-elements/video/Video.astro";
import { slugifyLabel } from "@components/utils/slugify";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

const {
  id = "",
  label,
  imageSource = "",
  imageAlt = "",
  videoSource = "",
  videoIntroSource = "",
  heading = "",
  subtext = "",
  metaLeft = "",
  metaRight = "",
  buttonSections = [],
  scrollMask = false,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

if (!htmlAttributes.id && (id || label)) {
  htmlAttributes.id = id || slugifyLabel(label);
}

const splitLines = (value: unknown) =>
  typeof value === "string"
    ? value
        .split(/<br\s*\/?>/i)
        .map((line) => line.trim())
        .filter(Boolean)
    : [];

const hasButtons = Array.isArray(buttonSections) && buttonSections.length > 0;
const headingLines = splitLines(heading);
const description =
  typeof subtext === "string" && subtext.trim() !== "" ? subtext.trim() : "";
const tags = [...splitLines(metaLeft), ...splitLines(metaRight)];
const hasCopy = Boolean(headingLines.length || description || tags.length || hasButtons);
const hasVideo = typeof videoSource === "string" && videoSource.trim() !== "";
const trimmedVideoIntro =
  typeof videoIntroSource === "string" && videoIntroSource.trim() !== ""
    ? videoIntroSource.trim()
    : "";
const imageDataAttributes = useDefaultEditableBinding
  ? { "data-prop-src": "imageSource", "data-prop-alt": "imageAlt" }
  : {};
const Track = scrollMask ? "div" : Fragment;
const trackProps = scrollMask ? { class: "hero-image-banner-track", "data-hero-track": "" } : {};
const descriptionEnterIndex = headingLines.length;
const tagsEnterIndex = headingLines.length + (description ? 1 : 0);
---

<Track {...trackProps}>
  <section
    class:list={[
      "hero-image-banner",
      hasVideo && "has-video",
      scrollMask && "is-scroll-mask",
      className,
    ]}
    {...htmlAttributes}
  >
    <div class="hero-image-banner__frame">
      <Image
        class="hero-image-banner__media"
        source={imageSource}
        alt={imageAlt}
        priority={true}
        background={true}
        positionVertical="center"
        positionHorizontal="center"
        {...imageDataAttributes}
      />
      {
        hasVideo && (
          <Video
            class="hero-image-banner__video"
            type="local-source"
            source={videoSource}
            introSource={trimmedVideoIntro}
            thumbnail={imageSource}
            background={true}
          />
        )
      }
      <div
        class="hero-image-banner__overlay"
        aria-hidden="true"
      >
      </div>
    </div>
    {
      hasCopy && (
        <div class="hero-image-banner__copy">
          {headingLines.length > 0 && (
            <h1
              class="hero-image-banner__title"
              data-editable={useDefaultEditableBinding ? "text" : undefined}
              data-type={useDefaultEditableBinding ? "text" : undefined}
              data-prop={useDefaultEditableBinding ? "heading" : undefined}
            >
              {headingLines.map((line, index) => (
                <span
                  class="hero-image-banner__line"
                  style={`--enter-index: ${index}`}
                >
                  <span
                    class="hero-image-banner__line-inner"
                    set:html={line}
                  />
                </span>
              ))}
            </h1>
          )}

          {
            description && (
              <p
                class="hero-image-banner__description"
                style={`--enter-index: ${descriptionEnterIndex}`}
                data-editable={useDefaultEditableBinding ? "text" : undefined}
                data-type={useDefaultEditableBinding ? "text" : undefined}
                data-prop={useDefaultEditableBinding ? "subtext" : undefined}
                set:html={description}
              />
            )
          }

          {
            tags.length > 0 && (
              <ul
                class="hero-image-banner__tags"
                style={`--enter-index: ${tagsEnterIndex}`}
              >
                {tags.map((tag) => (
                  <li class="hero-image-banner__tag">
                    <span set:html={tag} />
                  </li>
                ))}
              </ul>
            )
          }

          {
            hasButtons && (
              <ButtonGroup
                class="hero-image-banner__actions"
                buttonSections={buttonSections}
                alignmentHorizontal="start"
                useDefaultEditableBinding={useDefaultEditableBinding}
                data-children-prop="buttonSections"
              />
            )
          }
        </div>
      )
    }
  </section>
</Track>

<script>
  let teardown: (() => void) | undefined;

  const init = () => {
    teardown?.();
    const tracks = Array.from(document.querySelectorAll<HTMLElement>("[data-hero-track]"));
    if (!tracks.length) return;
    const events = new AbortController();
    let ticking = false;

    const measure = () => {
      ticking = false;
      for (const track of tracks) {
        const section = track.querySelector<HTMLElement>(".hero-image-banner")!;
        const rect = track.getBoundingClientRect();
        const travel = Math.max(1, rect.height - window.innerHeight);
        const progress = Math.min(1, Math.max(0, -rect.top / travel));

        section.style.setProperty("--hero-mask", String(Math.min(1, progress / 0.85)));
        section.style.setProperty("--hero-copy", String(Math.min(1, progress / 0.35)));
      }
    };
    const schedule = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(measure);
    };

    window.addEventListener("scroll", schedule, { passive: true, signal: events.signal });
    window.addEventListener("resize", schedule, { passive: true, signal: events.signal });
    measure();
    teardown = () => events.abort();
  };

  document.addEventListener("astro:page-load", init);
</script>

<style is:global>
  @layer page-sections {
    @keyframes hero-image-banner-line-rise {
      from {
        transform: translate3d(0, 108%, 0);
      }

      to {
        transform: translate3d(0, 0, 0);
      }
    }

    @keyframes hero-image-banner-meta-in {
      from {
        opacity: 0;
        transform: translate3d(0, 1.25rem, 0);
      }

      to {
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }
    }

    .hero-image-banner {
      background: #000;
      isolation: isolate;
      margin-top: calc(var(--spacing-nav-height) * -1);
      min-height: 100vh;
      min-height: 100dvh;
      overflow: hidden;
      position: relative;
      width: 100%;

      > .hero-image-banner__frame {
        background: #000;
        inset: 0;
        overflow: hidden;
        position: absolute;
        z-index: 0;
      }

      .hero-image-banner__frame > .hero-image-banner__media {
        inset: 0;
        margin-top: 0;
        position: absolute;
        z-index: 0;
      }

      .hero-image-banner__frame > .hero-image-banner__video {
        inset: 0;
        margin-top: 0;
        position: absolute;
        z-index: 0;
      }

      &.has-video .hero-image-banner__frame > .hero-image-banner__media {
        z-index: 0;
      }

      &.has-video .hero-image-banner__frame > .hero-image-banner__video {
        z-index: 1;
      }

      .hero-image-banner__frame > .hero-image-banner__overlay {
        background:
          linear-gradient(90deg, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0.28) 48%, transparent 78%),
          linear-gradient(0deg, rgba(0, 0, 0, 0.5) 0%, transparent 42%);
        inset: 0;
        pointer-events: none;
        position: absolute;
        z-index: 2;
      }

      &.is-scroll-mask {
        --hero-mask: 0;
        --hero-copy: 0;
        background-color: #000;
        height: 100vh;
        height: 100dvh;
        margin-top: 0;
        min-height: 0;
        position: sticky;
        top: 0;

        > .hero-image-banner__frame {
          bottom: calc(var(--hero-mask) * 16vh);
          clip-path: inset(
            calc(var(--hero-mask) * 3vh) calc(var(--hero-mask) * 3vw) calc(var(--hero-mask) * 3vh)
              round calc(var(--hero-mask) * 10px)
          );
          left: calc(var(--hero-mask) * 3vw);
          right: calc(var(--hero-mask) * 3vw);
          top: calc(var(--hero-mask) * (var(--spacing-nav-height) + 3.5vh));
        }

        .hero-image-banner__frame > .hero-image-banner__media,
        .hero-image-banner__frame > .hero-image-banner__video {
          scale: calc(1.06 - var(--hero-mask) * 0.06);
        }

        .hero-image-banner__frame > .hero-image-banner__overlay {
          opacity: calc(1 + var(--hero-mask) * 0.15);
        }

        > .hero-image-banner__copy {
          opacity: calc(1 - var(--hero-copy));
          translate: 0 calc(var(--hero-copy) * -36px);
        }
      }

      /* Left-aligned editorial type stack */
      > .hero-image-banner__copy {
        align-items: flex-start;
        bottom: 11vh;
        display: flex;
        flex-direction: column;
        gap: clamp(1.25rem, 2.4vh, 1.85rem);
        justify-content: flex-end;
        left: clamp(0.75rem, 3.5vw, 2.75rem);
        margin: 0;
        max-width: min(40rem, 100%);
        padding: clamp(1.5rem, 4vh, 3rem) clamp(1.25rem, 3.5vw, 2.75rem);
        position: absolute;
        right: auto;
        text-align: left;
        top: calc(var(--spacing-nav-height) + 3.5vh);
        width: min(40rem, calc(100% - 2 * clamp(0.75rem, 3.5vw, 2.75rem)));
        z-index: var(--layer-2);
      }

      .hero-image-banner__title {
        color: #fff !important;
        font-family: var(--font-headings);
        font-size: clamp(2rem, 4.6vw, 3.75rem);
        font-weight: 600;
        letter-spacing: -0.03em;
        line-height: 1.05;
        margin: 0;
        max-width: 18ch;
        text-shadow: none;
        white-space: normal;
      }

      .hero-image-banner__line {
        display: block;
        overflow: hidden;
        padding-bottom: 0.04em;
      }

      .hero-image-banner__line-inner {
        animation: hero-image-banner-line-rise 1100ms cubic-bezier(0.16, 1, 0.3, 1) both;
        animation-delay: calc(180ms + var(--enter-index, 0) * 120ms);
        display: block;
        font-weight: inherit;
      }

      .hero-image-banner__description {
        animation: hero-image-banner-meta-in 900ms cubic-bezier(0.22, 1, 0.36, 1) both;
        animation-delay: calc(280ms + var(--enter-index, 0) * 120ms);
        color: rgba(255, 255, 255, 0.78);
        font-family: var(--font-body);
        font-size: clamp(0.95rem, 1.35vw, 1.125rem);
        font-weight: 400;
        letter-spacing: 0.01em;
        line-height: 1.55;
        margin: 0;
        max-width: 34ch;
      }

      .hero-image-banner__tags {
        animation: hero-image-banner-meta-in 900ms cubic-bezier(0.22, 1, 0.36, 1) both;
        animation-delay: calc(360ms + var(--enter-index, 0) * 120ms);
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .hero-image-banner__tag {
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.16);
        border-radius: 999px;
        color: rgba(255, 255, 255, 0.88);
        font-family: var(--font-body);
        font-size: clamp(0.72rem, 1vw, 0.82rem);
        font-weight: 500;
        letter-spacing: 0.02em;
        line-height: 1;
        padding: 0.55rem 0.9rem;
      }

      .hero-image-banner__actions {
        animation: hero-image-banner-meta-in 900ms cubic-bezier(0.22, 1, 0.36, 1) both;
        animation-delay: calc(520ms + var(--enter-index, 0) * 120ms);
        margin-top: 0.25rem;
        width: auto;
      }

      .hero-image-banner__actions > .button-group__items {
        gap: var(--spacing-md);
        justify-content: flex-start;
      }

      .hero-image-banner__actions .button-inner.variant-secondary {
        background-color: rgba(255, 255, 255, 0.12);
        border-color: rgba(255, 255, 255, 0.55);
        color: #fff;
      }

      .hero-image-banner__actions .button-inner.variant-secondary:hover {
        background-color: rgba(255, 255, 255, 0.22);
        border-color: #fff;
        color: #fff;
      }

      @media (width < 768px) {
        min-height: 100dvh;

        > .hero-image-banner__frame {
          inset: 0;
        }

        &.is-scroll-mask {
          > .hero-image-banner__frame {
            bottom: calc(var(--hero-mask) * 12vh);
            clip-path: inset(
              calc(var(--hero-mask) * 2.5vh) calc(var(--hero-mask) * 2.5vw)
                calc(var(--hero-mask) * 2.5vh) round calc(var(--hero-mask) * 8px)
            );
            left: calc(var(--hero-mask) * 2.5vw);
            right: calc(var(--hero-mask) * 2.5vw);
            top: calc(var(--hero-mask) * (var(--spacing-nav-height) + 2vh));
          }
        }

        > .hero-image-banner__copy {
          bottom: 7vh;
          gap: 1.1rem;
          left: 0.75rem;
          max-width: none;
          padding: 1rem 0.85rem 1.25rem;
          right: 0.75rem;
          top: calc(var(--spacing-nav-height) + 2vh);
          width: auto;
        }

        .hero-image-banner__title {
          font-size: clamp(1.75rem, 8vw, 2.35rem);
          max-width: 14ch;
        }

        .hero-image-banner__description {
          font-size: 0.95rem;
          max-width: 28ch;
        }

        .hero-image-banner__actions .button-inner {
          font-size: var(--font-size-sm);
          min-height: 2.5rem;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .hero-image-banner__line-inner,
        .hero-image-banner__description,
        .hero-image-banner__tags,
        .hero-image-banner__actions {
          animation: none;
        }
      }
    }

    .hero-image-banner-track {
      background-color: #000;
      margin-top: calc(var(--spacing-nav-height) * -1);
      min-height: 200vh;
      position: relative;
    }
  }
</style>
