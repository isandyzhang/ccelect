---
import Image from "@core-elements/image/Image.astro";
import Video from "@core-elements/video/Video.astro";
import { slugifyLabel } from "@components/utils/slugify";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

const {
  id = "",
  label,
  imageSource = "",
  imageAlt = "",
  videoSource = "",
  videoIntroSource = "",
  heading = "",
  subtext = "",
  buttonSections = [],
  scrollMask = false,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

if (!htmlAttributes.id && (id || label)) {
  htmlAttributes.id = id || slugifyLabel(label);
}

const hasButtons = Array.isArray(buttonSections) && buttonSections.length > 0;
const hasCopy = Boolean(heading || subtext || hasButtons);
const hasVideo = typeof videoSource === "string" && videoSource.trim() !== "";
const trimmedVideoIntro =
  typeof videoIntroSource === "string" && videoIntroSource.trim() !== ""
    ? videoIntroSource.trim()
    : "";
const imageDataAttributes = useDefaultEditableBinding
  ? { "data-prop-src": "imageSource", "data-prop-alt": "imageAlt" }
  : {};
const Track = scrollMask ? "div" : Fragment;
const trackProps = scrollMask ? { class: "hero-image-banner-track", "data-hero-track": "" } : {};
---

<Track {...trackProps}>
  <section
    class:list={[
      "hero-image-banner",
      hasVideo && "has-video",
      scrollMask && "is-scroll-mask",
      className,
    ]}
    {...htmlAttributes}
  >
    <div class="hero-image-banner__frame">
      <Image
        class="hero-image-banner__media"
        source={imageSource}
        alt={imageAlt}
        priority={true}
        background={true}
        positionVertical="center"
        positionHorizontal="center"
        {...imageDataAttributes}
      />
  {
    hasVideo && (
      <Video
        class="hero-image-banner__video"
        type="local-source"
        source={videoSource}
        introSource={trimmedVideoIntro}
        thumbnail={imageSource}
        background={true}
      />
    )
  }
      <div
        class="hero-image-banner__overlay"
        aria-hidden="true"
      >
      </div>
    </div>
    {
      hasCopy && (
        <div class="hero-image-banner__copy">
          {heading && (
            <h1
              class="hero-image-banner__title"
              data-editable={useDefaultEditableBinding ? "text" : undefined}
              data-type={useDefaultEditableBinding ? "text" : undefined}
              data-prop={useDefaultEditableBinding ? "heading" : undefined}
              set:html={heading}
            />
          )}
          {subtext && (
            <p
              class="hero-image-banner__subtext"
              data-editable={useDefaultEditableBinding ? "text" : undefined}
              data-type={useDefaultEditableBinding ? "text" : undefined}
              data-prop={useDefaultEditableBinding ? "subtext" : undefined}
              set:html={subtext}
            />
          )}
          {hasButtons && (
            <ButtonGroup
              class="hero-image-banner__actions"
              buttonSections={buttonSections}
              alignmentHorizontal="start"
              useDefaultEditableBinding={useDefaultEditableBinding}
              data-children-prop="buttonSections"
            />
          )}
        </div>
      )
    }
  </section>
</Track>

<script>
  let teardown: (() => void) | undefined;

  const init = () => {
    teardown?.();
    const tracks = Array.from(document.querySelectorAll<HTMLElement>("[data-hero-track]"));
    if (!tracks.length) return;
    const events = new AbortController();
    let ticking = false;

    const measure = () => {
      ticking = false;
      for (const track of tracks) {
        const section = track.querySelector<HTMLElement>(".hero-image-banner")!;
        const rect = track.getBoundingClientRect();
        const travel = Math.max(1, rect.height - window.innerHeight);
        const progress = Math.min(1, Math.max(0, -rect.top / travel));

        section.style.setProperty("--hero-mask", String(Math.min(1, progress / 0.85)));
        section.style.setProperty("--hero-copy", String(Math.min(1, progress / 0.35)));
      }
    };
    const schedule = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(measure);
    };

    window.addEventListener("scroll", schedule, { passive: true, signal: events.signal });
    window.addEventListener("resize", schedule, { passive: true, signal: events.signal });
    measure();
    teardown = () => events.abort();
  };

  document.addEventListener("astro:page-load", init);
</script>

<style is:global>
  @layer page-sections {
    @keyframes hero-image-banner-rise {
      from {
        opacity: 0;
        transform: translate3d(0, 2.5rem, 0);
      }

      to {
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }
    }

    .hero-image-banner {
      isolation: isolate;
      margin-top: calc(var(--spacing-nav-height) * -1);
      min-height: 100vh;
      min-height: 100dvh;
      overflow: hidden;
      position: relative;
      width: 100%;

      > .hero-image-banner__frame {
        inset: 0;
        position: absolute;
        z-index: 0;
      }

      .hero-image-banner__frame > .hero-image-banner__media {
        inset: 0;
        margin-top: 0;
        position: absolute;
        z-index: 0;
      }

      .hero-image-banner__frame > .hero-image-banner__video {
        inset: 0;
        margin-top: 0;
        position: absolute;
        z-index: 0;
      }

      &.has-video .hero-image-banner__frame > .hero-image-banner__media {
        z-index: 0;
      }

      &.has-video .hero-image-banner__frame > .hero-image-banner__video {
        z-index: 1;
      }

      .hero-image-banner__frame > .hero-image-banner__overlay {
        background-color: rgba(23, 34, 52, 0.45);
        inset: 0;
        pointer-events: none;
        position: absolute;
        z-index: 2;
      }

      &.is-scroll-mask {
        --hero-mask: 0;
        --hero-copy: 0;
        background-color: #000;
        height: 100vh;
        height: 100dvh;
        margin-top: 0;
        min-height: 0;
        position: sticky;
        top: 0;

        > .hero-image-banner__frame {
          clip-path: inset(
            calc(var(--hero-mask) * 14vh) calc(var(--hero-mask) * 8vw) calc(var(--hero-mask) * 8vh)
              round calc(var(--hero-mask) * 28px)
          );
        }

        .hero-image-banner__frame > .hero-image-banner__media,
        .hero-image-banner__frame > .hero-image-banner__video {
          scale: calc(1.08 - var(--hero-mask) * 0.08);
        }

        .hero-image-banner__frame > .hero-image-banner__overlay {
          background-color: rgba(23, 34, 52, calc(0.45 + var(--hero-mask) * 0.2));
        }

        > .hero-image-banner__copy {
          opacity: calc(1 - var(--hero-copy));
          translate: 0 calc(var(--hero-copy) * -60px);
        }
      }

      > .hero-image-banner__copy {
        align-items: end;
        bottom: 0;
        column-gap: clamp(1.75rem, 5vw, 4.5rem);
        display: grid;
        grid-template-columns: minmax(min-content, 0.72fr) minmax(0, 1.4fr);
        height: fit-content;
        left: clamp(1.5rem, 4vw, 3.25rem);
        margin-block: auto;
        max-width: none;
        padding: 0;
        position: absolute;
        right: clamp(1.5rem, 4vw, 3.25rem);
        text-align: left;
        top: 0;
        z-index: var(--layer-2);
      }

      .hero-image-banner__title,
      .hero-image-banner__subtext,
      .hero-image-banner__actions {
        animation: hero-image-banner-rise 900ms cubic-bezier(0.22, 1, 0.36, 1) both;
      }

      .hero-image-banner__title {
        animation-delay: 120ms;
        color: #fff !important;
        font-family: var(--font-headings);
        font-size: clamp(2.35rem, 4.4vw, 4.5rem);
        font-weight: var(--font-weight-semibold);
        grid-column: 1;
        letter-spacing: -0.035em;
        line-height: 0.98;
        margin: 0;
        text-shadow: 0 1px 12px rgba(0, 0, 0, 0.35);
        white-space: nowrap;
      }

      .hero-image-banner__subtext {
        align-self: end;
        animation-delay: 280ms;
        color: #fff !important;
        font-family: var(--font-body);
        font-size: clamp(0.95rem, 1.15vw, 1.125rem);
        grid-column: 2;
        line-height: 1.55;
        margin: 0;
        max-width: none;
        text-shadow: 0 1px 12px rgba(0, 0, 0, 0.35);
        white-space: nowrap;
        width: max-content;
      }

      .hero-image-banner__actions {
        animation-delay: 440ms;
        margin-top: var(--spacing-sm);
        width: auto;
      }

      .hero-image-banner__actions > .button-group__items {
        gap: var(--spacing-md);
      }

      .hero-image-banner__actions .button-inner.variant-secondary {
        background-color: rgba(255, 255, 255, 0.12);
        border-color: rgba(255, 255, 255, 0.55);
        color: #fff;
      }

      .hero-image-banner__actions .button-inner.variant-secondary:hover {
        background-color: rgba(255, 255, 255, 0.22);
        border-color: #fff;
        color: #fff;
      }

      @media (768px <= width < 72rem) {
        > .hero-image-banner__copy {
          grid-template-columns: minmax(0, 1fr);
          row-gap: 0.75rem;
        }

        .hero-image-banner__title,
        .hero-image-banner__subtext {
          grid-column: 1;
          max-width: 100%;
          white-space: normal;
          width: auto;
        }
      }

      /* Mobile: aspect-ratio width/height = 2/3 (tall 3:2) */
      @media (width < 768px) {
        aspect-ratio: 2 / 3;
        height: auto;
        min-height: min(100dvh, 42rem);
        width: 100%;

        .hero-image-banner__frame > .hero-image-banner__media,
        .hero-image-banner__frame > .hero-image-banner__video,
        .hero-image-banner__frame > .hero-image-banner__video.video.background,
        .hero-image-banner__frame > .hero-image-banner__video > video {
          height: 100%;
          min-height: 100%;
          width: 100%;
        }

        &.is-scroll-mask {
          aspect-ratio: auto;

          > .hero-image-banner__frame {
            clip-path: inset(
              calc(var(--hero-mask) * 10vh) calc(var(--hero-mask) * 4vw)
                calc(var(--hero-mask) * 4vh) round calc(var(--hero-mask) * 18px)
            );
          }
        }

        > .hero-image-banner__copy {
          bottom: 0;
          column-gap: 0;
          grid-template-columns: 1fr;
          height: fit-content;
          left: var(--spacing-lg);
          margin-block: auto;
          max-width: calc(100% - 2 * var(--spacing-lg));
          padding: 0;
          right: var(--spacing-lg);
          row-gap: var(--spacing-sm);
          top: 0;
        }

        .hero-image-banner__title {
          font-size: clamp(1.75rem, 8vw, 2.4rem);
          white-space: normal;
        }

        .hero-image-banner__subtext {
          display: block;
          font-size: var(--font-size-md);
          grid-column: 1;
          overflow: visible;
          white-space: normal;
          width: 100%;
        }

        .hero-image-banner__actions .button-inner {
          font-size: var(--font-size-sm);
          min-height: 2.5rem;
        }
      }

    }

    .hero-image-banner-track {
      background-color: #000;
      margin-top: calc(var(--spacing-nav-height) * -1);
      min-height: 200vh;
      position: relative;
    }
  }
</style>
