---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Icon from "@core-elements/icon/Icon.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

const {
  id = "",
  eyebrowIcon = {},
  eyebrowText = "",
  heading = "",
  subtext = "",
  buttonSections = [],
  colorScheme = "inherit",
  maxContentWidth = "xl",
  backgroundColor,
  contentBackground = false,
  paddingVertical = "4xl",
  class: className,
  rounded = false,
  _component,
  ...htmlAttributes
} = Astro.props;
---

<CustomSection
  class:list={["cta-center", className]}
  contentClass={rounded ? "cta-center-rounded" : ""}
  label={id}
  maxContentWidth={maxContentWidth}
  paddingHorizontal="md"
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  backgroundColor={backgroundColor}
  contentBackground={contentBackground}
  rounded={false}
  style={`--max-width: var(--content-width-${maxContentWidth})`}
  id={id}
  {...htmlAttributes}
>
  <Icon {...eyebrowIcon} />
  <SimpleText
    alignmentHorizontal="center"
    class="eyebrow"
    data-prop="eyebrowText"
  >
    {eyebrowText}
  </SimpleText>
  <Heading
    level="h2"
    size="xl"
    alignmentHorizontal="center"
    data-prop="heading"
    text={heading}
  />
  <Text
    alignmentHorizontal="center"
    data-prop="subtext"
    text={subtext}
  />
  <ButtonGroup
    class="buttons"
    buttonSections={buttonSections}
    alignmentHorizontal="center"
    data-children-prop="buttonSections"
  />
</CustomSection>

<style is:global>
  @layer page-sections {
    .cta-center {
      margin: var(--spacing-xl) 0;
      container-type: inline-size;
      container-name: cta-center;

      .outer-content {
        position: relative;
        z-index: 0;
      }
      .outer-content > .content {
        position: static;
      }

      .outer-content > .radial-background-wrapper,
      .outer-content > .radial-background-wrapper > .radial-background {
        z-index: var(--layer-below);
      }

      .icon.align-center {
        margin: 0 auto;
      }

      .outer-content.cta-center-rounded {
        > .background {
          border-top-right-radius: var(--radius-md);
          border-bottom-right-radius: var(--radius-md);

          @container cta-center (max-width: 1024px) {
            border-radius: var(--radius-md);
          }
        }
      }
    }
  }
</style>
