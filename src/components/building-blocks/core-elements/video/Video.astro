---
import { resolveVideoPosterSource } from "@component-utils/image";
import type { VideoSource } from "@component-utils/discoverVideoSources";

const {
  type,
  videoId,
  title,
  source,
  thumbnail,
  background = false,
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const trimmedThumbnail =
  typeof thumbnail === "string" && thumbnail.trim() !== "" ? thumbnail.trim() : "";

const posterUrl = trimmedThumbnail ? await resolveVideoPosterSource(trimmedThumbnail) : undefined;

let localVideoSources: VideoSource[] = [];

if (type === "local-source" && source) {
  const { discoverVideoSources } = await import("@component-utils/discoverVideoSources");

  localVideoSources = await discoverVideoSources(source);

  // Prefer a single playable MP4 for background heroes to avoid source-selection quirks.
  if (background) {
    const mp4 = localVideoSources.find((item) => item.type === "video/mp4");
    if (mp4) localVideoSources = [mp4];
  }
}
---

{
  type === "vimeo" ? (
    <lite-vimeo
      class:list={["video", className]}
      videotitle={`${title}`}
      videoid={`${videoId}`}
      {...htmlAttributes}
    >
      <a
        class="lite-vimeo-fallback"
        href={`https://vimeo.com/${videoId}`}
      >
        Watch on Vimeo: "{title}"
      </a>
    </lite-vimeo>
  ) : type === "youtube" ? (
    <lite-youtube
      class:list={["video", className]}
      videotitle={`${title}`}
      videoid={`${videoId}`}
      {...htmlAttributes}
    >
      <a
        class="lite-youtube-fallback"
        href={`https://www.youtube.com/watch?v=${videoId}`}
      >
        Watch on YouTube: "{title}"
      </a>
    </lite-youtube>
  ) : background ? (
    <div
      class:list={["video", "background", className]}
      aria-hidden="true"
      data-bg-video="true"
      {...htmlAttributes}
    >
      <video
        class="bg-video-el"
        preload="auto"
        autoplay
        muted
        loop
        playsinline
        disablepictureinpicture
        disableremoteplayback
        poster={posterUrl}
      >
        {localVideoSources.map(({ src, type: sourceType }) => (
          <source
            src={src}
            type={sourceType}
          />
        ))}
      </video>
    </div>
  ) : (
    <video
      preload="none"
      controls
      poster={posterUrl}
      class:list={["video", className]}
      {...htmlAttributes}
    >
      {localVideoSources.map(({ src, type: sourceType }) => (
        <source
          src={src}
          type={sourceType}
        />
      ))}
      Your browser does not support the HTML5 video element.
    </video>
  )
}

<style is:global>
  @layer components {
    .video {
      display: block;
      margin-top: var(--spacing-lg);

      &.background {
        inset: 0;
        margin-top: 0;
        overflow: hidden;
        pointer-events: none;
        position: absolute;

        > video,
        > .bg-video-el {
          display: block;
          height: 100%;
          min-height: 100%;
          object-fit: cover;
          object-position: var(--background-position, center center);
          width: 100%;
        }
      }
    }
  }
</style>

<script>
  const PLAY_ATTR = "data-bg-video-playing";

  function unlockAndPlay(video: HTMLVideoElement) {
    video.muted = true;
    video.defaultMuted = true;
    video.volume = 0;
    video.playsInline = true;
    video.setAttribute("muted", "");
    video.setAttribute("playsinline", "");
    video.setAttribute("webkit-playsinline", "true");
    video.loop = true;

    const run = () =>
      video.play().then(() => {
        video.setAttribute(PLAY_ATTR, "true");
      });

    return run().catch(() => {
      // iOS / strict autoplay: retry after first gesture or when visible.
      const retry = () => {
        run().catch(() => {});
      };

      window.addEventListener("touchstart", retry, { once: true, passive: true });
      window.addEventListener("pointerdown", retry, { once: true });
      document.addEventListener("visibilitychange", () => {
        if (!document.hidden) retry();
      });
    });
  }

  function playBackgroundVideos() {
    const videos = document.querySelectorAll<HTMLVideoElement>(
      ".video.background video, video.bg-video-el"
    );

    videos.forEach((video) => {
      if (video.getAttribute(PLAY_ATTR) === "true" && !video.paused) return;

      const start = () => {
        void unlockAndPlay(video);
      };

      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                start();
                io.disconnect();
              }
            });
          },
          { threshold: 0.15 }
        );

        io.observe(video);
      }

      if (video.readyState >= 2) {
        start();
      } else {
        video.addEventListener("loadeddata", start, { once: true });
        video.addEventListener("canplay", start, { once: true });
        try {
          video.load();
        } catch {
          /* ignore */
        }
      }
    });
  }

  const boot = () => {
    playBackgroundVideos();
    // Second pass after layout/fonts settle (helps mobile + view transitions).
    window.setTimeout(playBackgroundVideos, 300);
    window.setTimeout(playBackgroundVideos, 1000);
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot, { once: true });
  } else {
    boot();
  }

  document.addEventListener("astro:page-load", boot);
  document.addEventListener("astro:after-swap", boot);
</script>
