---
import { resolveVideoPosterSource } from "@component-utils/image";
import type { VideoSource } from "@component-utils/discoverVideoSources";

const {
  type,
  videoId,
  title,
  source,
  introSource = "",
  thumbnail,
  background = false,
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const trimmedThumbnail =
  typeof thumbnail === "string" && thumbnail.trim() !== "" ? thumbnail.trim() : "";
const trimmedIntroSource =
  typeof introSource === "string" && introSource.trim() !== "" ? introSource.trim() : "";

const posterUrl = trimmedThumbnail ? await resolveVideoPosterSource(trimmedThumbnail) : undefined;

let localVideoSources: VideoSource[] = [];
let introVideoSources: VideoSource[] = [];
let backgroundIntroSrc = "";
let backgroundLoopSrc = "";

if (type === "local-source" && source) {
  const { discoverVideoSources } = await import("@component-utils/discoverVideoSources");

  localVideoSources = await discoverVideoSources(source);

  // Prefer a single MP4 for background heroes to avoid multi-source quirks.
  if (background) {
    const mp4 = localVideoSources.find((item) => item.type === "video/mp4");

    if (mp4) localVideoSources = [mp4];
    backgroundLoopSrc = localVideoSources[0]?.src ?? "";
  }

  if (background && trimmedIntroSource) {
    introVideoSources = await discoverVideoSources(trimmedIntroSource);
    const introMp4 = introVideoSources.find((item) => item.type === "video/mp4");

    if (introMp4) introVideoSources = [introMp4];
    backgroundIntroSrc = introVideoSources[0]?.src ?? "";
  }
}

const backgroundHasIntro = Boolean(background && backgroundIntroSrc && backgroundLoopSrc);
const backgroundInitialSources = backgroundHasIntro ? introVideoSources : localVideoSources;
---

{
  type === "vimeo" ? (
    <lite-vimeo
      class:list={["video", className]}
      videotitle={`${title}`}
      videoid={`${videoId}`}
      {...htmlAttributes}
    >
      <a
        class="lite-vimeo-fallback"
        href={`https://vimeo.com/${videoId}`}
      >
        Watch on Vimeo: "{title}"
      </a>
    </lite-vimeo>
  ) : type === "youtube" ? (
    <lite-youtube
      class:list={["video", className]}
      videotitle={`${title}`}
      videoid={`${videoId}`}
      {...htmlAttributes}
    >
      <a
        class="lite-youtube-fallback"
        href={`https://www.youtube.com/watch?v=${videoId}`}
      >
        Watch on YouTube: "{title}"
      </a>
    </lite-youtube>
  ) : background ? (
    <div
      class:list={["video", "background", className]}
      aria-hidden="true"
      {...htmlAttributes}
    >
      {/* Sources use data-src so the file is not fetched until visible. */}
      <video
        preload="none"
        muted
        loop={!backgroundHasIntro}
        playsinline
        disablepictureinpicture
        disableremoteplayback
        poster={posterUrl}
        data-bg-intro-src={backgroundHasIntro ? backgroundIntroSrc : undefined}
        data-bg-loop-src={backgroundHasIntro ? backgroundLoopSrc : undefined}
      >
        {backgroundInitialSources.map(({ src, type: sourceType }) => (
          <source
            data-src={src}
            type={sourceType}
          />
        ))}
      </video>
    </div>
  ) : (
    <video
      preload="none"
      controls
      poster={posterUrl}
      class:list={["video", className]}
      {...htmlAttributes}
    >
      {localVideoSources.map(({ src, type: sourceType }) => (
        <source
          src={src}
          type={sourceType}
        />
      ))}
      Your browser does not support the HTML5 video element.
    </video>
  )
}

<style is:global>
  @layer components {
    .video {
      display: block;
      margin-top: var(--spacing-lg);

      &.background {
        inset: 0;
        margin-top: 0;
        overflow: hidden;
        pointer-events: none;
        position: absolute;

        > video {
          display: block;
          height: 100%;
          min-height: 100%;
          object-fit: cover;
          object-position: var(--background-position, center center);
          width: 100%;
        }
      }
    }
  }
</style>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";

  let cleanup: (() => void) | undefined;

  function initBackgroundVideos() {
    cleanup?.();
    const events = new AbortController();
    const { signal } = events;
    const releases: (() => void)[] = [];
    const connection = (navigator as Navigator & { connection?: { saveData?: boolean } })
      .connection;

    document.querySelectorAll<HTMLVideoElement>(".video.background video").forEach((video) => {
      let visible = false;
      let retryBound = false;
      let loop = !video.dataset.bgIntroSrc;
      const pause = () => {
        video.pause();
        video.removeAttribute("data-bg-video-playing");
      };
      const play = () => {
        if (
          signal.aborted ||
          !video.isConnected ||
          !visible ||
          document.hidden ||
          connection?.saveData
        ) {
          pause();
          return;
        }
        if (!video.paused) return;
        if (video.dataset.bgVideoLoaded !== "true") {
          video.querySelectorAll<HTMLSourceElement>("source").forEach((source) => {
            source.src =
              (!loop && video.dataset.bgIntroSrc) ||
              video.dataset.bgLoopSrc ||
              source.dataset.src ||
              source.src;
          });
          video.dataset.bgVideoLoaded = "true";
          video.load();
        }
        video.muted = true;
        video.defaultMuted = true;
        video.playsInline = true;
        video.loop = loop;
        void video
          .play()
          .then(() => {
            if (signal.aborted || !visible || document.hidden) pause();
            else video.setAttribute("data-bg-video-playing", "true");
          })
          .catch(() => {
            if (retryBound || signal.aborted) return;
            retryBound = true;
            window.addEventListener(
              "pointerdown",
              () => {
                retryBound = false;
                play();
              },
              { once: true, signal }
            );
          });
      };
      video.addEventListener(
        "ended",
        () => {
          if (!video.dataset.bgLoopSrc) return;
          loop = true;
          video.dataset.bgVideoLoaded = "false";
          play();
        },
        { signal }
      );
      document.addEventListener("visibilitychange", play, { signal });
      const observer = new IntersectionObserver(
        ([entry]) => {
          visible = entry.isIntersecting;
          play();
        },
        { threshold: 0.1 }
      );
      observer.observe(video);
      releases.push(() => {
        observer.disconnect();
        pause();
      });
    });
    cleanup = () => {
      events.abort();
      releases.forEach((release) => release());
    };
  }

  document.addEventListener("astro:before-swap", () => cleanup?.());
  onPageLoad(initBackgroundVideos);
</script>
