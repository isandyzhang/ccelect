---
import { resolveVideoPosterSource } from "@component-utils/image";
import type { VideoSource } from "@component-utils/discoverVideoSources";

const {
  type,
  videoId,
  title,
  source,
  introSource = "",
  thumbnail,
  background = false,
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const trimmedThumbnail =
  typeof thumbnail === "string" && thumbnail.trim() !== "" ? thumbnail.trim() : "";
const trimmedIntroSource =
  typeof introSource === "string" && introSource.trim() !== "" ? introSource.trim() : "";

const posterUrl = trimmedThumbnail ? await resolveVideoPosterSource(trimmedThumbnail) : undefined;

let localVideoSources: VideoSource[] = [];
let introVideoSources: VideoSource[] = [];
let backgroundIntroSrc = "";
let backgroundLoopSrc = "";

if (type === "local-source" && source) {
  const { discoverVideoSources } = await import("@component-utils/discoverVideoSources");

  localVideoSources = await discoverVideoSources(source);

  // Prefer a single MP4 for background heroes to avoid multi-source quirks.
  if (background) {
    const mp4 = localVideoSources.find((item) => item.type === "video/mp4");

    if (mp4) localVideoSources = [mp4];
    backgroundLoopSrc = localVideoSources[0]?.src ?? "";
  }

  if (background && trimmedIntroSource) {
    introVideoSources = await discoverVideoSources(trimmedIntroSource);
    const introMp4 = introVideoSources.find((item) => item.type === "video/mp4");

    if (introMp4) introVideoSources = [introMp4];
    backgroundIntroSrc = introVideoSources[0]?.src ?? "";
  }
}

const backgroundHasIntro = Boolean(background && backgroundIntroSrc && backgroundLoopSrc);
const backgroundInitialSources = backgroundHasIntro ? introVideoSources : localVideoSources;
---

{
  type === "vimeo" ? (
    <lite-vimeo
      class:list={["video", className]}
      videotitle={`${title}`}
      videoid={`${videoId}`}
      {...htmlAttributes}
    >
      <a
        class="lite-vimeo-fallback"
        href={`https://vimeo.com/${videoId}`}
      >
        Watch on Vimeo: "{title}"
      </a>
    </lite-vimeo>
  ) : type === "youtube" ? (
    <lite-youtube
      class:list={["video", className]}
      videotitle={`${title}`}
      videoid={`${videoId}`}
      {...htmlAttributes}
    >
      <a
        class="lite-youtube-fallback"
        href={`https://www.youtube.com/watch?v=${videoId}`}
      >
        Watch on YouTube: "{title}"
      </a>
    </lite-youtube>
  ) : background ? (
    <div
      class:list={["video", "background", className]}
      aria-hidden="true"
      {...htmlAttributes}
    >
      {/* Sources use data-src so the file is not fetched until visible. */}
      <video
        preload="none"
        muted
        loop={!backgroundHasIntro}
        playsinline
        disablepictureinpicture
        disableremoteplayback
        poster={posterUrl}
        data-bg-intro-src={backgroundHasIntro ? backgroundIntroSrc : undefined}
        data-bg-loop-src={backgroundHasIntro ? backgroundLoopSrc : undefined}
      >
        {backgroundInitialSources.map(({ src, type: sourceType }) => (
          <source
            data-src={src}
            type={sourceType}
          />
        ))}
      </video>
    </div>
  ) : (
    <video
      preload="none"
      controls
      poster={posterUrl}
      class:list={["video", className]}
      {...htmlAttributes}
    >
      {localVideoSources.map(({ src, type: sourceType }) => (
        <source
          src={src}
          type={sourceType}
        />
      ))}
      Your browser does not support the HTML5 video element.
    </video>
  )
}

<style is:global>
  @layer components {
    .video {
      display: block;
      margin-top: var(--spacing-lg);

      &.background {
        inset: 0;
        margin-top: 0;
        overflow: hidden;
        pointer-events: none;
        position: absolute;

        > video {
          display: block;
          height: 100%;
          min-height: 100%;
          object-fit: cover;
          object-position: var(--background-position, center center);
          width: 100%;
        }
      }
    }
  }
</style>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";

  const PLAYING = "data-bg-video-playing";
  const LOADED = "data-bg-video-loaded";

  function prefersReducedMotion() {
    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  }

  function prefersSaveData() {
    const connection = (navigator as Navigator & { connection?: { saveData?: boolean } })
      .connection;
    return Boolean(connection?.saveData);
  }

  function hydrateSources(video: HTMLVideoElement, preferredSrc?: string) {
    if (video.getAttribute(LOADED) === "true" && !preferredSrc) return;

    let hydrated = false;
    video.querySelectorAll("source").forEach((node) => {
      const source = node as HTMLSourceElement;
      const nextSrc = preferredSrc || source.dataset.src || source.getAttribute("src");
      if (!nextSrc) return;
      source.src = nextSrc;
      source.removeAttribute("data-src");
      hydrated = true;
    });

    if (hydrated) {
      video.setAttribute(LOADED, "true");
      video.load();
    }
  }

  function switchToLoop(video: HTMLVideoElement) {
    const loopSrc = video.dataset.bgLoopSrc;
    if (!loopSrc) return;

    video.loop = true;
    hydrateSources(video, loopSrc);

    const playLoop = () => {
      void video.play().then(() => {
        video.setAttribute(PLAYING, "true");
      }).catch(() => {});
    };

    if (video.readyState >= 2) playLoop();
    else video.addEventListener("canplay", playLoop, { once: true });
  }

  function bindIntroToLoop(video: HTMLVideoElement) {
    if (!video.dataset.bgIntroSrc || !video.dataset.bgLoopSrc) return;
    if (video.dataset.bgIntroBound === "true") return;
    video.dataset.bgIntroBound = "true";

    video.addEventListener("ended", () => {
      switchToLoop(video);
    });
  }

  function unlockAndPlay(video: HTMLVideoElement) {
    if (prefersReducedMotion() || prefersSaveData()) {
      video.pause();
      video.removeAttribute(PLAYING);
      return;
    }

    if (video.getAttribute(PLAYING) === "true" && !video.paused) return;

    const hasIntro = Boolean(video.dataset.bgIntroSrc && video.dataset.bgLoopSrc);

    hydrateSources(video, hasIntro ? video.dataset.bgIntroSrc : undefined);
    bindIntroToLoop(video);

    video.muted = true;
    video.defaultMuted = true;
    video.playsInline = true;
    video.setAttribute("muted", "");
    video.setAttribute("playsinline", "");
    video.loop = !hasIntro;

    const tryPlay = () =>
      video.play().then(() => {
        video.setAttribute(PLAYING, "true");
      });

    const startWhenReady = () => {
      void tryPlay().catch(() => {
        const retry = () => {
          void tryPlay().catch(() => {});
        };

        window.addEventListener("pointerdown", retry, { once: true });
        window.addEventListener("touchstart", retry, { once: true, passive: true });
        document.addEventListener(
          "visibilitychange",
          () => {
            if (!document.hidden) retry();
          },
          { once: true }
        );
      });
    };

    if (video.readyState >= 2) {
      startWhenReady();
    } else {
      video.addEventListener("canplay", startWhenReady, { once: true });
    }
  }

  function freezeBackgroundVideo(video: HTMLVideoElement) {
    video.pause();
    video.removeAttribute(PLAYING);
  }

  function bindReducedMotionToggle(video: HTMLVideoElement) {
    if (video.dataset.bgMotionBound === "true") return;
    video.dataset.bgMotionBound = "true";

    const media = window.matchMedia("(prefers-reduced-motion: reduce)");
    const onChange = () => {
      if (media.matches) freezeBackgroundVideo(video);
      else unlockAndPlay(video);
    };

    media.addEventListener("change", onChange);
  }

  function initBackgroundVideos() {
    document.querySelectorAll<HTMLVideoElement>(".video.background video").forEach((video) => {
      bindReducedMotionToggle(video);

      if (prefersReducedMotion() || prefersSaveData()) {
        freezeBackgroundVideo(video);
        return;
      }

      if (video.getAttribute(PLAYING) === "true" && !video.paused) return;

      const start = () => unlockAndPlay(video);

      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            if (entries.some((entry) => entry.isIntersecting)) {
              start();
              io.disconnect();
            }
          },
          { rootMargin: "80px", threshold: 0.1 }
        );
        io.observe(video);
      } else {
        start();
      }
    });
  }

  onPageLoad(initBackgroundVideos);
</script>
