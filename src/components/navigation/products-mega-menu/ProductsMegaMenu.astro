---
import type { Locale } from "@i18n/config";
import { defaultLocale } from "@i18n/config";
import { experienceText } from "@i18n/experience";

interface NavChild {
  name: string;
  path?: string;
  hint?: string;
  children?: NavChild[];
}

interface Props {
  navData?: NavChild[];
  locale?: Locale;
  class?: string;
  label?: string;
}

const {
  navData = [],
  locale = defaultLocale as Locale,
  class: className,
  label,
} = Astro.props;

const copy = experienceText[locale] ?? experienceText[defaultLocale];
const regionLabel = label || copy.products;
---

<div
  class:list={["products-mega-menu", className]}
  role="region"
  aria-label={regionLabel}
  data-products-mega
>
  <div class="products-mega-menu__inner">
    <div class="products-mega-menu__grid">
      {
        navData.map((column, index) => {
          const children = column.children ?? [];
          const hasChildren = children.length > 0;
          const browseLabel = copy.browseAll.replace("{name}", column.name);
          const isPrimary = index === 0;

          return (
            <div
              class:list={[
                "products-mega-menu__column",
                isPrimary && "products-mega-menu__column--primary",
              ]}
            >
              {column.path ? (
                <a
                  href={column.path}
                  class="products-mega-menu__heading"
                >
                  {column.name}
                </a>
              ) : (
                <p class="products-mega-menu__heading">{column.name}</p>
              )}
              <ul class="products-mega-menu__list">
                {hasChildren
                  ? children.map((child) => (
                      <li>
                        <a
                          href={child.path}
                          class="products-mega-menu__link"
                        >
                          <span class="products-mega-menu__link-name">{child.name}</span>
                          {child.hint ? (
                            <span class="products-mega-menu__link-hint">{child.hint}</span>
                          ) : null}
                        </a>
                      </li>
                    ))
                  : (
                      <li>
                        <a
                          href={column.path}
                          class="products-mega-menu__link products-mega-menu__link--browse"
                        >
                          {browseLabel}
                        </a>
                      </li>
                    )}
              </ul>
            </div>
          );
        })
      }
    </div>
  </div>
</div>

<style is:global>
  @layer components {
    /*
      Desktop product menu. Every column uses the same type size and row gap
      so the lists line up. Phone uses the side flyout instead.
    */
    .products-mega-menu {
      --mega-label: clamp(0.875rem, 0.75rem + 0.25vw, 1rem);
      --mega-link-secondary: clamp(0.9375rem, 0.78rem + 0.32vw, 1.0625rem);
      --mega-pad-block: clamp(2.5rem, 4vw, 3.5rem);
      --mega-pad-inline: clamp(1.5rem, 5vw, 3rem);
      --mega-gap: clamp(2rem, 4vw, 3.5rem);
      --mega-max: 78rem;

      background: var(--color-bg-surface);
      border-bottom: 1px solid rgb(0 0 0 / 8%);
      box-shadow: 0 12px 28px rgb(0 0 0 / 6%);
      left: 0;
      max-height: min(85vh, 48rem);
      opacity: 0;
      overflow-x: hidden;
      overflow-y: auto;
      overscroll-behavior: contain;
      pointer-events: none;
      position: absolute;
      right: 0;
      /* Bridge any gap under the sticky bar so hover doesn't drop while scrolling */
      top: calc(100% - 0.5rem);
      padding-top: 0.5rem;
      transform: translateY(-0.4rem);
      transition:
        opacity 0.28s cubic-bezier(0.4, 0, 0.6, 1),
        transform 0.28s cubic-bezier(0.4, 0, 0.6, 1),
        visibility 0.28s;
      visibility: hidden;
      z-index: calc(var(--layer-2) + 1);
      -webkit-overflow-scrolling: touch;
    }

    .main-nav:not(.mega-force-closed):has(.nav-item.has-mega:hover) .products-mega-menu,
    .main-nav:not(.mega-force-closed):has(.nav-item.has-mega:focus-within) .products-mega-menu,
    .main-nav:not(.mega-force-closed):has(.products-mega-menu:hover) .products-mega-menu,
    .main-nav:not(.mega-force-closed):has(.products-mega-menu:focus-within) .products-mega-menu,
    .main-nav.is-mega-open .products-mega-menu {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
      visibility: visible;
    }

    /* Soft page dim like Apple */
    .main-nav::after {
      background: rgb(0 0 0 / 0.28);
      content: "";
      inset: 100% 0 -100vh;
      opacity: 0;
      pointer-events: none;
      position: absolute;
      transition: opacity 0.28s ease;
      z-index: var(--layer-2);
    }

    .main-nav:not(.mega-force-closed):has(.nav-item.has-mega:hover)::after,
    .main-nav:not(.mega-force-closed):has(.nav-item.has-mega:focus-within)::after,
    .main-nav:not(.mega-force-closed):has(.products-mega-menu:hover)::after,
    .main-nav:not(.mega-force-closed):has(.products-mega-menu:focus-within)::after,
    .main-nav.is-mega-open::after {
      opacity: 1;
    }

    .products-mega-menu__inner {
      margin-inline: auto;
      max-width: min(100%, var(--mega-max));
      padding: var(--mega-pad-block) var(--mega-pad-inline) calc(var(--mega-pad-block) + 0.5rem);
    }

    .products-mega-menu__grid {
      align-items: start;
      display: grid;
      gap: var(--mega-gap);
      grid-template-columns: repeat(5, minmax(11rem, 1fr));
    }

    .products-mega-menu__column {
      min-width: 0;
    }

    .products-mega-menu__heading {
      color: #424245;
      display: inline-block;
      font-size: var(--mega-label);
      font-weight: 600;
      letter-spacing: -0.01em;
      line-height: 1.33334;
      margin: 0 0 0.7rem;
      text-decoration: none;
    }

    a.products-mega-menu__heading:hover,
    a.products-mega-menu__heading:focus-visible {
      color: var(--color-brand, #0066cc);
      text-decoration: underline;
      text-underline-offset: 0.15em;
    }

    .products-mega-menu__list {
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .products-mega-menu__link {
      color: var(--color-text-strong, #1d1d1f);
      display: inline-flex;
      flex-wrap: wrap;
      align-items: baseline;
      font-size: var(--mega-link-secondary);
      font-weight: 600;
      gap: 0.15em;
      letter-spacing: -0.01em;
      line-height: 1.25;
      text-decoration: none;
    }

    .products-mega-menu__link:hover,
    .products-mega-menu__link:focus-visible {
      color: var(--color-brand, #0066cc);
    }

    .products-mega-menu__link-hint {
      color: #6e6e73;
      font-size: 0.85em;
      font-weight: 400;
      letter-spacing: 0;
    }

    .products-mega-menu__column--primary .products-mega-menu__link-hint {
      font-size: 0.55em;
      font-weight: 400;
    }

    .products-mega-menu__link--browse {
      font-weight: 500;
    }

    /* ~Apple medium desktop: tighten band, keep 5 cols if possible */
    @media (max-width: 84rem) {
      .products-mega-menu {
        --mega-max: 72rem;
        --mega-gap: clamp(1.5rem, 2.5vw, 2.5rem);
      }
    }

    /* Tablet landscape / smaller desktop — wrap like Apple denser layouts */
    @media (max-width: 75rem) {
      .products-mega-menu {
        --mega-label: 0.9375rem;
        --mega-link-secondary: 1rem;
        --mega-pad-block: 2.25rem;
        --mega-gap: 1.75rem 2rem;
        max-height: min(72vh, 38rem);
      }

      .products-mega-menu__grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .products-mega-menu__column--primary {
        grid-column: 1 / -1;
      }

      .products-mega-menu__column--primary .products-mega-menu__list {
        column-gap: 2rem;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
        row-gap: 0.65rem;
      }
    }

    @media (max-width: 64rem) {
      .products-mega-menu,
      .main-nav::after {
        display: none;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .products-mega-menu,
      .main-nav::after {
        transition: none;
      }

      .products-mega-menu {
        transform: none;
      }
    }
  }
</style>
