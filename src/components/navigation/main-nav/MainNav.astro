---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Bar from "@components/navigation/bar/Bar.astro";
import LanguageSwitcher from "@components/navigation/language-switcher/LanguageSwitcher.astro";
import Mobile from "@components/navigation/mobile/Mobile.astro";
import ThemeToggle from "@components/navigation/theme-toggle/ThemeToggle.astro";
import Image from "@core-elements/image/Image.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";
import type { Locale } from "@i18n/config";
import { defaultLocale } from "@i18n/config";
import type { NavButton } from "../../../types";

const {
  logoSource,
  logoAlternateSource,
  logoAlt = "logo",
  navData = [],
  buttonSections = [] as NavButton[],
  themeToggle = false,
  homeHref = "/",
  locale = defaultLocale as Locale,
  pageKey = "",
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const mobileNavData = [
  ...navData,
  ...buttonSections.map((button: any) => ({
    name: button.text || "Button",
    path: button.link || button.href || "#",
    children: [],
  })),
];
---

<CustomSection
  maxContentWidth="2xl"
  paddingHorizontal="lg"
  paddingVertical="none"
  colorScheme="light"
  backgroundColor=""
  class:list={["main-nav", className]}
  {...htmlAttributes}
  useDefaultEditableBinding={false}
>
  <a
    href={homeHref}
    class="main-nav-logo-link"
  >
    <Image
      source={logoSource}
      alternateSource={logoAlternateSource}
      class="main-nav-logo"
      alt={logoAlt}
      useDefaultEditableBinding={false}
    />
  </a>
  <div class="nav-end">
    <Bar
      navData={navData}
      class="desktop-main-nav"
    />

    <LanguageSwitcher
      locale={locale}
      pageKey={pageKey}
    />
    {themeToggle && <ThemeToggle />}
    <ButtonGroup
      direction="row"
      align="center"
      class="desktop-button-group"
      style="gap: var(--spacing-xl);"
      buttonSections={buttonSections}
      useDefaultEditableBinding={false}
    />
  </div>
  <Mobile
    logoSource={logoSource}
    logoAlternateSource={logoAlternateSource}
    logoAlt={logoAlt}
    navData={mobileNavData}
    class="mobile-main-nav"
    useDefaultEditableBinding={false}
  />
</CustomSection>

<script>
  import { onPageLoad } from "@components/utils/onPageLoad";
  import { isLocale, localeLabels, localeNames, localizedHref } from "@i18n/config";

  function syncPersistedMainNav() {
    const navRoot = document.querySelector(".main-nav");

    if (!(navRoot instanceof HTMLElement)) return;

    const pathname = window.location.pathname;
    const pageKey = document.querySelector<HTMLMetaElement>('meta[name="page-key"]')?.content ?? "";
    const siteLocale =
      document.querySelector<HTMLMetaElement>('meta[name="site-locale"]')?.content ?? "zh-tw";

    navRoot.querySelectorAll<HTMLAnchorElement>("a[href]").forEach((link) => {
      const href = link.getAttribute("href");

      if (!href || href.startsWith("#") || href.includes("mailto:")) return;

      if (link.closest(".language-menu")) {
        const locale = link.dataset.locale;

        if (!locale || !isLocale(locale)) return;

        link.href = localizedHref(locale, pageKey);
        const isActive = locale === siteLocale;

        link.classList.toggle("is-active", isActive);

        if (isActive) {
          link.setAttribute("aria-current", "page");
        } else {
          link.removeAttribute("aria-current");
        }

        const check = link.querySelector(".check");

        if (check) {
          check.textContent = isActive ? "✓" : "";
        }

        return;
      }

      const linkPath = new URL(href, window.location.origin).pathname;

      if (linkPath === pathname) {
        link.setAttribute("aria-current", "page");
      } else {
        link.removeAttribute("aria-current");
      }
    });

    const summary = navRoot.querySelector(".lang-switcher summary");
    const summaryLabel = navRoot.querySelector(
      ".lang-switcher summary > span:not(.language-icon):not(.chevron)"
    );

    if (summary instanceof HTMLElement && isLocale(siteLocale)) {
      summary.setAttribute("aria-label", `Language: ${localeNames[siteLocale]}`);
    }

    if (summaryLabel instanceof HTMLElement && isLocale(siteLocale)) {
      summaryLabel.textContent = localeLabels[siteLocale];
    }
  }

  onPageLoad(syncPersistedMainNav);
</script>

<style is:global>
  @layer page-sections {
    .main-nav {
      z-index: var(--layer-2);
      padding: var(--spacing-md) var(--spacing-sm);
      position: sticky;
      top: 0;
      overflow: visible;
      pointer-events: none;

      .desktop-main-nav.bar,
      .desktop-button-group.button-group {
        @container (max-width: 768px) {
          display: none;
        }
      }

      .nav-hamburger.mobile-button {
        @container (min-width: 769px) {
          display: none;
        }
      }

      > .outer-content > .content {
        align-items: center;
        container-type: inline-size;
        display: flex;
        gap: var(--spacing-md);
        background-color: var(--color-bg);
        border: 2px solid var(--color-border-subtle);
        box-shadow: 10px 10px 29px 10px var(--color-shadow);
        padding: var(--spacing-md) var(--spacing-md) var(--spacing-md) var(--spacing-2xl);
        border-top-left-radius: var(--radius-4xl);
        border-bottom-left-radius: var(--radius-4xl);
        border-top-right-radius: var(--radius-md);
        border-bottom-right-radius: var(--radius-md);
        pointer-events: all;

        .main-nav-logo {
          margin-top: 0;
        }

        > a > .image img {
          height: 3.25rem;
          max-width: 286px;
          width: auto;
        }

        > a {
          flex-shrink: 0;
        }

        .button-group {
          margin-top: 0;

          > .button-group__items {
            gap: var(--spacing-xl);
            width: auto;
          }

          .button > .button-inner {
            border-radius: var(--radius-sm);
          }
        }
      }

      > .outer-content > .content > .nav-end {
        align-items: center;
        display: flex;
        gap: var(--spacing-md);
        justify-content: flex-end;
        width: 100%;
        flex-grow: 1;
        > .button-group {
          container-type: normal;
          flex: 0 0 auto;
          width: auto;
        }
      }
    }
  }
</style>
