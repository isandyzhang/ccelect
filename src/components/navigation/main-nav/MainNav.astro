---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Bar from "@components/navigation/bar/Bar.astro";
import LanguageSwitcher from "@components/navigation/language-switcher/LanguageSwitcher.astro";
import Mobile from "@components/navigation/mobile/Mobile.astro";
import ThemeToggle from "@components/navigation/theme-toggle/ThemeToggle.astro";
import Image from "@core-elements/image/Image.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";
import type { Locale } from "@i18n/config";
import { defaultLocale } from "@i18n/config";
import type { NavButton } from "../../../types";

const {
  logoSource,
  logoAlternateSource,
  logoAlt = "logo",
  navData = [],
  buttonSections = [] as NavButton[],
  themeToggle = false,
  homeHref = "/",
  locale = defaultLocale as Locale,
  pageKey = "",
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const mobileNavData = [
  ...navData,
  ...buttonSections.map((button: any) => ({
    name: button.text || "Button",
    path: button.link || button.href || "#",
    children: [],
  })),
];
---

<CustomSection
  maxContentWidth="none"
  paddingHorizontal="lg"
  paddingVertical="none"
  colorScheme="light"
  backgroundColor=""
  class:list={["main-nav", className]}
  {...htmlAttributes}
  useDefaultEditableBinding={false}
>
  <a
    href={homeHref}
    class="main-nav-logo-link"
  >
    <Image
      source={logoSource}
      alternateSource={logoAlternateSource}
      class="main-nav-logo"
      alt={logoAlt}
      useDefaultEditableBinding={false}
    />
  </a>
  <div class="nav-end">
    <Bar
      navData={navData}
      class="desktop-main-nav"
    />

    <LanguageSwitcher
      locale={locale}
      pageKey={pageKey}
    />
    {themeToggle && <ThemeToggle />}
    <ButtonGroup
      direction="row"
      align="center"
      class="desktop-button-group"
      style="gap: var(--spacing-xl);"
      buttonSections={buttonSections}
      useDefaultEditableBinding={false}
    />
  </div>
  <Mobile
    logoSource={logoSource}
    logoAlternateSource={logoAlternateSource}
    logoAlt={logoAlt}
    navData={mobileNavData}
    class="mobile-main-nav"
    persistKey={`mobile-main-nav-${locale}`}
    useDefaultEditableBinding={false}
  />
</CustomSection>

<script>
  import { onPageLoad } from "@components/utils/onPageLoad";
  import { isLocale, localeNames, localizedHref } from "@i18n/config";

  function syncPersistedMainNav() {
    const navRoot = document.querySelector(".main-nav");

    if (!(navRoot instanceof HTMLElement)) return;

    const pathname = window.location.pathname;
    const pageKey = document.querySelector<HTMLMetaElement>('meta[name="page-key"]')?.content ?? "";
    const siteLocale =
      document.querySelector<HTMLMetaElement>('meta[name="site-locale"]')?.content ?? "zh-tw";

    document
      .querySelectorAll<HTMLAnchorElement>(".main-nav a[href], .mobile-main-nav a[href]")
      .forEach((link) => {
        const href = link.getAttribute("href");

        if (!href || href.startsWith("#") || href.includes("mailto:")) return;

        if (link.closest(".language-menu")) {
          const locale = link.dataset.locale;

          if (!locale || !isLocale(locale)) return;

          link.href = localizedHref(locale, pageKey);
          const isActive = locale === siteLocale;

          link.classList.toggle("is-active", isActive);

          if (isActive) {
            link.setAttribute("aria-current", "page");
          } else {
            link.removeAttribute("aria-current");
          }

          const check = link.querySelector(".check");

          if (check) {
            check.textContent = isActive ? "✓" : "";
          }

          return;
        }

        const linkPath = new URL(href, window.location.origin).pathname;

        if (linkPath === pathname) {
          link.setAttribute("aria-current", "page");
        } else {
          link.removeAttribute("aria-current");
        }
      });

    const summary = navRoot.querySelector(".lang-switcher summary");

    if (summary instanceof HTMLElement && isLocale(siteLocale)) {
      summary.setAttribute("aria-label", `Language: ${localeNames[siteLocale]}`);
    }
  }

  onPageLoad(syncPersistedMainNav);
</script>

<style is:global>
  @layer page-sections {
    .main-nav {
      z-index: var(--layer-2);
      padding: 0;
      position: sticky;
      top: 0;
      overflow: visible;
      pointer-events: auto;
      background-color: var(--color-bg-surface);
      /* Dark theme's subtle border matches the surface, so use the visible border token. */
      border-bottom: 1px solid var(--color-border);

      .desktop-main-nav.bar,
      .desktop-button-group.button-group {
        @media (max-width: 64rem) {
          display: none;
        }
      }

      .nav-hamburger.mobile-button {
        @media (width > 64rem) {
          display: none;
        }
      }

      > .outer-content > .content {
        align-items: center;
        display: flex;
        gap: var(--spacing-md);
        max-width: none;
        width: 100%;
        padding: var(--nav-content-pad-block) var(--spacing-xl);
        min-width: 0;

        .main-nav-logo {
          margin-top: 0;
          max-width: 100%;
          overflow: visible;

          > .image-inner {
            overflow: visible;
            width: auto;
            max-width: 100%;

            picture {
              width: auto;
              max-width: 100%;
            }
          }
        }

        > a.main-nav-logo-link {
          flex: 0 1 var(--nav-logo-width);
          min-width: 0;
          max-width: var(--nav-logo-width);
        }

        > a > .image img {
          display: block;
          height: var(--nav-logo-height);
          width: auto;
          max-width: 100%;
          object-fit: contain;
          object-position: left center;
        }

        @media (max-width: 75rem) {
          gap: var(--spacing-sm);
          padding-inline: var(--spacing-lg);
        }

        .button-group {
          margin-top: 0;

          > .button-group__items {
            gap: var(--spacing-md);
            width: auto;
          }

          .button > .button-inner {
            border-radius: var(--radius-sm);
            font-size: calc(var(--font-size-sm) * 1.25);
            min-height: var(--nav-cta-min-height);
            padding-inline: var(--spacing-md);
          }

          .button > .button-inner.icon-only {
            aspect-ratio: 1;
            background: var(--color-bg-surface);
            border: 1px solid var(--color-border);
            border-radius: 999px;
            height: 2.75rem;
            min-height: 2.75rem;
            min-width: 2.75rem;
            padding: 0;
            width: 2.75rem;
          }

          .button > .button-inner.icon-only:hover {
            background: var(--color-bg-surface);
            border-color: var(--color-brand);
            color: var(--color-brand);
          }

          .button > .button-inner.icon-only:focus-visible {
            box-shadow: 0 0 0 3px var(--color-focus-ring);
            outline: none;
          }

          .button > .button-inner.icon-only .icon,
          .button > .button-inner.icon-only .icon svg {
            height: 1.35rem;
            width: 1.35rem;
          }
        }
      }

      .nav-end > .theme-toggle,
      .nav-hamburger.mobile-button .button > .button-inner {
        align-items: center;
        background: var(--color-bg-surface);
        border: 1px solid var(--color-border);
        border-radius: 999px;
        color: var(--color-text-strong);
        display: inline-flex;
        flex-shrink: 0;
        height: 2.75rem;
        justify-content: center;
        min-height: 2.75rem;
        min-width: 2.75rem;
        padding: 0;
        width: 2.75rem;
      }

      .nav-end > .theme-toggle:hover,
      .nav-hamburger.mobile-button .button > .button-inner:hover {
        background: var(--color-bg-surface);
        border-color: var(--color-brand);
        color: var(--color-brand);
      }

      .nav-end > .theme-toggle:focus-visible,
      .nav-hamburger.mobile-button:focus-visible .button > .button-inner {
        box-shadow: 0 0 0 3px var(--color-focus-ring);
        outline: none;
      }

      .nav-end > .theme-toggle svg,
      .nav-hamburger.mobile-button .button > .button-inner .icon,
      .nav-hamburger.mobile-button .button > .button-inner .icon svg {
        height: 1.35rem;
        width: 1.35rem;
      }

      .nav-hamburger {
        flex: 0 0 auto;
      }

      .nav-hamburger.mobile-button {
        font-size: var(--nav-hamburger-font);
        min-height: 2.75rem;
        min-width: 2.75rem;
      }

      .desktop-main-nav.bar {
        font-size: var(--font-size-md);
      }

      .desktop-main-nav.bar .bar-list {
        gap: var(--spacing-xs);
      }

      .desktop-main-nav.bar .nav-item > a,
      .desktop-main-nav.bar .nav-item > .nav-item-trigger {
        font-size: var(--font-size-md);
        padding: var(--spacing-sm) var(--spacing-sm);
        color: var(--color-text-strong);
      }

      .desktop-main-nav.bar .nav-item > a:hover,
      .desktop-main-nav.bar .nav-item > .nav-item-trigger:hover {
        color: var(--color-brand);
      }

      @media (max-width: 30rem) {
        > .outer-content > .content {
          gap: var(--spacing-sm);
          padding-inline: var(--spacing-md);
        }

        > .outer-content > .content > .nav-end {
          gap: var(--spacing-sm);
        }
      }

      > .outer-content > .content > .nav-end {
        align-items: center;
        display: flex;
        gap: var(--spacing-md);
        justify-content: flex-end;
        flex: 1 0 auto;
        width: auto;
        min-width: 0;
        > .button-group {
          container-type: normal;
          flex: 0 0 auto;
          width: auto;
        }
      }
    }
  }
</style>
