---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Bar from "@components/navigation/bar/Bar.astro";
import LanguageSwitcher from "@components/navigation/language-switcher/LanguageSwitcher.astro";
import Mobile from "@components/navigation/mobile/Mobile.astro";
import ProductsMegaMenu from "@components/navigation/products-mega-menu/ProductsMegaMenu.astro";
import ThemeToggle from "@components/navigation/theme-toggle/ThemeToggle.astro";
import Image from "@core-elements/image/Image.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";
import type { Locale } from "@i18n/config";
import { defaultLocale } from "@i18n/config";
import { experienceText } from "@i18n/experience";
import { getProductsNav } from "@i18n/loadData";
import type { NavButton } from "../../../types";

const {
  logoSource,
  logoAlternateSource,
  logoAlt = "logo",
  navData = [],
  buttonSections = [] as NavButton[],
  themeToggle = false,
  homeHref = "/",
  locale = defaultLocale as Locale,
  pageKey = "",
  availablePages = {},
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const { navData: productsNavData = [] } = getProductsNav(locale);
const productsLabel = (experienceText[locale] ?? experienceText[defaultLocale]).products;

function isProductsShowcaseItem(item: { name?: string; path?: string }) {
  const path = item.path ?? "";
  if (/\/products\/?$/.test(path)) return true;
  if (/\/products\/exoweld\/?$/.test(path)) return true;
  return item.name === productsLabel;
}

const desktopNavData = navData.map((item: { name?: string; path?: string; children?: unknown[] }) =>
  isProductsShowcaseItem(item) ? { ...item, mega: true, children: [] } : item
);

const mobileNavData = [
  ...navData.map((item: { name?: string; path?: string; children?: unknown[] }) =>
    isProductsShowcaseItem(item) ? { ...item, children: productsNavData } : item
  ),
  ...buttonSections.map((button: any) => ({
    name: button.text || "Button",
    path: button.link || button.href || "#",
    children: [],
  })),
];
---

<CustomSection
  maxContentWidth="none"
  paddingHorizontal="lg"
  paddingVertical="none"
  colorScheme="light"
  backgroundColor=""
  class:list={["main-nav", className]}
  {...htmlAttributes}
  useDefaultEditableBinding={false}
>
  <a
    href={homeHref}
    class="main-nav-logo-link"
  >
    <Image
      source={logoSource}
      alternateSource={logoAlternateSource}
      class="main-nav-logo"
      alt={logoAlt}
      useDefaultEditableBinding={false}
    />
  </a>
  <div class="nav-end">
    <Bar
      navData={desktopNavData}
      class="desktop-main-nav"
    />

    <LanguageSwitcher
      locale={locale}
      pageKey={pageKey}
      availablePages={availablePages}
    />
    {themeToggle && <ThemeToggle />}
    <ButtonGroup
      direction="row"
      align="center"
      class="desktop-button-group"
      style="gap: var(--spacing-xl);"
      buttonSections={buttonSections}
      useDefaultEditableBinding={false}
    />
  </div>
  <ProductsMegaMenu
    navData={productsNavData}
    locale={locale}
    label={productsLabel}
  />
  <Mobile
    logoSource={logoSource}
    logoAlternateSource={logoAlternateSource}
    logoAlt={logoAlt}
    navData={mobileNavData}
    class="mobile-main-nav"
    persistKey={`mobile-main-nav-${locale}`}
    useDefaultEditableBinding={false}
  />
</CustomSection>

<script>
  import { onPageLoad } from "@components/utils/onPageLoad";
  import { isLocale, localeNames } from "@i18n/config";
  import { experienceText } from "@i18n/experience";

  let megaHandlersBound = false;

  function syncPersistedMainNav() {
    const navRoot = document.querySelector(".main-nav");

    if (!(navRoot instanceof HTMLElement)) return;

    const pathname = window.location.pathname;
    const availablePages = JSON.parse(
      document.querySelector<HTMLMetaElement>('meta[name="available-pages"]')?.content || "{}"
    );
    const siteLocale =
      document.querySelector<HTMLMetaElement>('meta[name="site-locale"]')?.content ?? "zh-tw";

    document
      .querySelectorAll<HTMLAnchorElement>(
        ".main-nav a[href], .main-nav .language-menu a[data-locale], .mobile-main-nav a[href]"
      )
      .forEach((link) => {
        const href = link.getAttribute("href");

        if (link.closest(".language-menu")) {
          const locale = link.dataset.locale;

          if (!locale || !isLocale(locale)) return;

          const href = availablePages[locale];
          if (href) link.href = href;
          else link.removeAttribute("href");
          link.setAttribute("aria-disabled", String(!href));
          if (isLocale(siteLocale)) {
            link.title = href ? "" : experienceText[siteLocale].untranslated;
          }
          if (href) link.removeAttribute("tabindex");
          else link.tabIndex = -1;
          const isActive = locale === siteLocale;

          link.classList.toggle("is-active", isActive);

          if (isActive) {
            link.setAttribute("aria-current", "page");
          } else {
            link.removeAttribute("aria-current");
          }

          const check = link.querySelector(".check");

          if (check) {
            check.textContent = isActive ? "✓" : "";
          }

          return;
        }

        if (!href || href.startsWith("#") || href.includes("mailto:")) return;

        const linkPath = new URL(href, window.location.origin).pathname;

        if (linkPath === pathname) {
          link.setAttribute("aria-current", "page");
        } else {
          link.removeAttribute("aria-current");
        }
      });

    const summary = navRoot.querySelector(".lang-switcher summary");

    if (summary instanceof HTMLElement && isLocale(siteLocale)) {
      summary.setAttribute("aria-label", `Language: ${localeNames[siteLocale]}`);
    }
  }

  function closeProductsMega(navRoot: HTMLElement) {
    navRoot.classList.remove("is-mega-open");
    navRoot.classList.add("mega-force-closed");
  }

  function clearMegaForceClose(navRoot: HTMLElement) {
    navRoot.classList.remove("mega-force-closed");
  }

  function initProductsMega() {
    const navRoot = document.querySelector(".main-nav");
    if (!(navRoot instanceof HTMLElement)) return;
    if (navRoot.dataset.megaInitialized === "true") return;

    const trigger = navRoot.querySelector<HTMLElement>(".nav-item.has-mega [data-mega-trigger]");
    const mega = navRoot.querySelector<HTMLElement>("[data-products-mega]");
    if (!trigger || !mega) return;

    navRoot.dataset.megaInitialized = "true";

    let closeTimer: number | null = null;

    const clearCloseTimer = () => {
      if (closeTimer == null) return;
      window.clearTimeout(closeTimer);
      closeTimer = null;
    };

    const isInsideMegaZone = (node: Node | null) => {
      if (!node) return false;
      return trigger.contains(node) || mega.contains(node) || trigger === node || mega === node;
    };

    const open = () => {
      clearCloseTimer();
      clearMegaForceClose(navRoot);
      navRoot.classList.add("is-mega-open");
    };

    const scheduleClose = (related: EventTarget | null) => {
      const next = related instanceof Node ? related : null;
      if (isInsideMegaZone(next)) return;

      clearCloseTimer();
      // Delay so scrollbar / wheel / trackpad scroll inside the panel
      // does not instantly drop :hover and close the menu.
      closeTimer = window.setTimeout(() => {
        closeTimer = null;
        if (trigger.matches(":hover") || mega.matches(":hover")) return;
        if (mega.contains(document.activeElement)) return;
        navRoot.classList.remove("is-mega-open");
      }, 280);
    };

    trigger.addEventListener("mouseenter", open);
    trigger.addEventListener("focus", open);
    mega.addEventListener("mouseenter", open);

    trigger.addEventListener("mouseleave", (e) => scheduleClose(e.relatedTarget));
    mega.addEventListener("mouseleave", (e) => scheduleClose(e.relatedTarget));

    // Keep open while the user scrolls the mega panel itself.
    mega.addEventListener(
      "wheel",
      () => {
        open();
      },
      { passive: true }
    );
    mega.addEventListener(
      "scroll",
      () => {
        open();
      },
      { passive: true }
    );

    if (!megaHandlersBound) {
      document.addEventListener("keydown", (e) => {
        if (e.key !== "Escape") return;
        const root = document.querySelector(".main-nav");
        if (!(root instanceof HTMLElement)) return;
        if (!root.classList.contains("is-mega-open") && !root.matches(":has(.nav-item.has-mega:focus-within), :has(.products-mega-menu:focus-within)")) {
          return;
        }
        closeProductsMega(root);
        const t = root.querySelector<HTMLElement>(".nav-item.has-mega [data-mega-trigger]");
        t?.focus();
      });

      document.addEventListener("click", (e) => {
        const root = document.querySelector(".main-nav");
        if (!(root instanceof HTMLElement)) return;
        const target = e.target;
        if (!(target instanceof Node)) return;
        if (root.querySelector(".nav-item.has-mega")?.contains(target)) return;
        if (root.querySelector("[data-products-mega]")?.contains(target)) return;
        root.classList.remove("is-mega-open");
      });

      megaHandlersBound = true;
    }
  }

  onPageLoad(() => {
    syncPersistedMainNav();
    initProductsMega();
  });
</script>

<style is:global>
  @layer page-sections {
    .main-nav {
      z-index: var(--layer-2);
      padding: 0;
      position: sticky;
      top: 0;
      overflow: visible;
      pointer-events: auto;
      background-color: var(--color-bg-surface);
      /* Dark theme's subtle border matches the surface, so use the visible border token. */
      border-bottom: 1px solid var(--color-border);

      .desktop-main-nav.bar,
      .desktop-button-group.button-group {
        @media (max-width: 64rem) {
          display: none;
        }
      }

      .nav-hamburger.mobile-button {
        @media (width > 64rem) {
          display: none;
        }
      }

      > .outer-content {
        overflow: visible;
      }

      > .outer-content > .content {
        align-items: center;
        display: flex;
        gap: var(--spacing-md);
        max-width: none;
        width: 100%;
        padding: var(--nav-content-pad-block) var(--spacing-xl);
        min-width: 0;
        overflow: visible;
        position: static;

        .main-nav-logo {
          margin-top: 0;
          max-width: 100%;
          overflow: visible;

          > .image-inner {
            overflow: visible;
            width: auto;
            max-width: 100%;

            picture {
              width: auto;
              max-width: 100%;
            }
          }
        }

        > a.main-nav-logo-link {
          flex: 0 1 var(--nav-logo-width);
          min-width: 0;
          max-width: var(--nav-logo-width);
        }

        > a > .image img {
          display: block;
          height: var(--nav-logo-height);
          width: auto;
          max-width: 100%;
          object-fit: contain;
          object-position: left center;
        }

        @media (max-width: 75rem) {
          gap: var(--spacing-sm);
          padding-inline: var(--spacing-lg);
        }

        .button-group {
          margin-top: 0;

          > .button-group__items {
            gap: var(--spacing-md);
            width: auto;
          }

          .button > .button-inner {
            border-radius: var(--radius-sm);
            font-size: calc(var(--font-size-sm) * 1.25);
            min-height: var(--nav-cta-min-height);
            padding-inline: var(--spacing-md);
          }

          .button > .button-inner.icon-only {
            aspect-ratio: 1;
            background: var(--color-bg-surface);
            border: 1px solid var(--color-border);
            border-radius: 999px;
            height: 2.75rem;
            min-height: 2.75rem;
            min-width: 2.75rem;
            padding: 0;
            width: 2.75rem;
          }

          .button > .button-inner.icon-only:hover {
            background: var(--color-bg-surface);
            border-color: var(--color-brand);
            color: var(--color-brand);
          }

          .button > .button-inner.icon-only:focus-visible {
            box-shadow: 0 0 0 3px var(--color-focus-ring);
            outline: none;
          }

          .button > .button-inner.icon-only .icon,
          .button > .button-inner.icon-only .icon svg {
            height: 1.35rem;
            width: 1.35rem;
          }
        }
      }

      .nav-end > .theme-toggle,
      .nav-hamburger.mobile-button .button > .button-inner {
        align-items: center;
        background: var(--color-bg-surface);
        border: 1px solid var(--color-border);
        border-radius: 999px;
        color: var(--color-text-strong);
        display: inline-flex;
        flex-shrink: 0;
        height: 2.75rem;
        justify-content: center;
        min-height: 2.75rem;
        min-width: 2.75rem;
        padding: 0;
        width: 2.75rem;
      }

      .nav-end > .theme-toggle:hover,
      .nav-hamburger.mobile-button .button > .button-inner:hover {
        background: var(--color-bg-surface);
        border-color: var(--color-brand);
        color: var(--color-brand);
      }

      .nav-end > .theme-toggle:focus-visible,
      .nav-hamburger.mobile-button:focus-visible .button > .button-inner {
        box-shadow: 0 0 0 3px var(--color-focus-ring);
        outline: none;
      }

      .nav-end > .theme-toggle svg,
      .nav-hamburger.mobile-button .button > .button-inner .icon,
      .nav-hamburger.mobile-button .button > .button-inner .icon svg {
        height: 1.35rem;
        width: 1.35rem;
      }

      .nav-hamburger {
        flex: 0 0 auto;
      }

      .nav-hamburger.mobile-button {
        font-size: var(--nav-hamburger-font);
        min-height: 2.75rem;
        min-width: 2.75rem;
      }

      /*
        Desktop nav copy scales with the viewport.
        Floor is 16px once the bar appears (64rem); cap is 18px on wide screens.
        Inline padding grows with the same range so items stay on one line.
      */
      .desktop-main-nav.bar {
        font-size: clamp(1rem, 0.7rem + 0.5vw, 1.125rem);
        letter-spacing: -0.01em;
        min-width: 0;
      }

      .desktop-main-nav.bar .bar-list {
        gap: clamp(0.1rem, 0.35vw, 0.4rem);
      }

      .desktop-main-nav.bar .nav-item > a,
      .desktop-main-nav.bar .nav-item > .nav-item-trigger {
        border-radius: 0;
        color: var(--color-text-strong, #1d1d1f);
        font-size: inherit;
        font-weight: 600;
        letter-spacing: -0.01em;
        line-height: 1.2;
        padding-block: 0.65rem;
        padding-inline: clamp(0.4rem, 0.12rem + 0.45vw, 0.85rem);
      }

      .desktop-main-nav.bar .nav-item > a:hover,
      .desktop-main-nav.bar .nav-item > .nav-item-trigger:hover,
      .desktop-main-nav.bar .nav-item-split:hover,
      .desktop-main-nav.bar .nav-item-split:hover .nav-item-link,
      .desktop-main-nav.bar .nav-item-split:hover .nav-item-toggle-btn,
      .desktop-main-nav.bar .nav-item-split .nav-item-toggle-btn:hover {
        background: transparent;
        border-color: transparent;
        color: var(--color-brand);
        opacity: 0.72;
      }

      .desktop-main-nav.bar .nav-item.has-mega > a:hover,
      .desktop-main-nav.bar .nav-item.has-mega > a:focus-visible,
      &:not(.mega-force-closed):has(.products-mega-menu:hover) .desktop-main-nav.bar .nav-item.has-mega > a,
      &.is-mega-open .desktop-main-nav.bar .nav-item.has-mega > a {
        color: var(--color-brand);
        opacity: 1;
      }

      @media (max-width: 30rem) {
        > .outer-content > .content {
          gap: var(--spacing-sm);
          padding-inline: var(--spacing-md);
        }

        > .outer-content > .content > .nav-end {
          gap: var(--spacing-sm);
        }
      }

      > .outer-content > .content > .nav-end {
        align-items: center;
        display: flex;
        gap: var(--spacing-md);
        justify-content: flex-end;
        flex: 1 0 auto;
        width: auto;
        min-width: 0;
        > .button-group {
          container-type: normal;
          flex: 0 0 auto;
          width: auto;
        }
      }
    }
  }
</style>
